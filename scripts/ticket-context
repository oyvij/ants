#!/usr/bin/env python3
"""What a ticket's implementer must read, in one call.

    scripts/ticket-context <n>

Prints the ticket and its comments, then every ticket it is blocked by and every ticket it blocks, each whole with
its comments (the upstream ones say what exists, the downstream ones settle scope), then its spec: the parent issue
it is a sub-issue of, with its comments.
"""
import json
import subprocess
import sys

REPO = "oyvij/ants"


def gh(*args):
    return json.loads(subprocess.run(["gh", *args], check=True, capture_output=True, text=True).stdout)


def issue(n):
    return gh("issue", "view", str(n), "-R", REPO, "--json", "number,title,state,body,comments")


def show(found, level="#"):
    n = found["number"]
    print(f"{level} #{n} {found['title']} [{found['state'].lower()}]\n\n{(found['body'] or '').strip()}\n")
    for comment in found["comments"]:
        print(f"{level}# Comment on #{n} by {comment['author']['login']}\n\n{comment['body'].strip()}\n")


def main():
    args = sys.argv[1:]
    if len(args) != 1 or args[0] in ("-h", "--help"):
        sys.exit(__doc__.strip())
    n = int(args[0])
    ticket = issue(n)
    show(ticket)
    for relation in ("blocked_by", "blocking"):
        for other in gh("api", f"repos/{REPO}/issues/{n}/dependencies/{relation}"):
            print(f"---\n\n**{relation.replace('_', ' ').capitalize()}:**\n")
            show(issue(other["number"]), "##")
    parent = subprocess.run(["gh", "api", f"repos/{REPO}/issues/{n}/parent", "--jq", ".number"], capture_output=True, text=True)
    if parent.returncode == 0:
        print("---\n\n**The spec:**\n")
        show(issue(int(parent.stdout)), "##")


if __name__ == "__main__":
    main()
