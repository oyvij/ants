#!/usr/bin/env python3
"""Everything a ticket's implementer must read, in one call, by default with nothing filtered out.

    scripts/ticket-context [--lean] <n>

Prints the ticket and its comments, then every ticket it is blocked by and every ticket it blocks, each whole with
its comments (the upstream ones say what exists, the downstream ones settle scope), then the whole spec (#27). It
saves calls, never content: everything the manual path would read is printed.

--lean prints only the spec sections the ticket cites instead of the whole spec: the user stories it names by number
("story 12", "stories 51-53"), and each section whose heading's words (or the words in its parentheses) all appear in
the ticket, then the headings it left out (for #46, 24 KB against 68 KB). Read the whole spec with `gh issue view 27`
when a left-out section bears on the ticket.
"""
import json
import re
import subprocess
import sys

REPO = "oyvij/ants"
SPEC = 27


def gh(*args):
    return json.loads(subprocess.run(["gh", *args], check=True, capture_output=True, text=True).stdout)


def issue(n):
    return gh("issue", "view", str(n), "-R", REPO, "--json", "number,title,state,body,comments")


def show(found, level="#"):
    n = found["number"]
    print(f"{level} #{n} {found['title']} [{found['state'].lower()}]\n\n{(found['body'] or '').strip()}\n")
    for comment in found["comments"]:
        print(f"{level}# Comment on #{n} by {comment['author']['login']}\n\n{comment['body'].strip()}\n")


def stems(text):
    """Words of three letters or more, an ending dropped and cut to five, so "Drawing" meets "drawn" and "Checks" "check"."""
    return {re.sub(r"(ing|ed|es|s|n)$", "", word)[:5] for word in re.findall(r"[a-z0-9]{3,}", text.lower())
            if word not in ("the", "and", "for", "with")}


def cited(spec, ticket):
    """The spec's sections and user stories that [ticket]'s text cites, in spec order, then the headings left out."""
    words = stems(ticket)
    stories = set()
    for numbers in re.findall(r"(?i)\bstor(?:y|ies)\s+([\d\s,–-]+(?:and\s+\d+)?)", ticket):
        for a, b in re.findall(r"(\d+)(?:\s*[–-]\s*(\d+))?", numbers):
            stories.update(range(int(a), int(b or a) + 1))
    out, left = [], []
    for section in re.split(r"(?m)^(?=##+ )", spec):
        heading = section.splitlines()[0] if section.startswith("#") else ""
        names = [re.sub(r"\(.*?\)", "", heading.lstrip("# "))] + re.findall(r"\((.*?)\)", heading)
        if heading and any(stems(name) and stems(name) <= words for name in names):
            out.append(section.rstrip() + "\n")
        else:
            out += [line for line in section.splitlines() if (m := re.match(r"(\d+)\. ", line)) and int(m[1]) in stories]
            left += [heading.lstrip("# ")] if heading else []
    return "\n".join(out + [f"\nLeft out: {'; '.join(left)}."])


def main():
    args = sys.argv[1:]
    lean = "--lean" in args
    args = [a for a in args if a != "--lean"]
    if len(args) != 1 or args[0] in ("-h", "--help"):
        sys.exit(__doc__.strip())
    n = int(args[0])
    ticket = issue(n)
    show(ticket)
    for relation in ("blocked_by", "blocking"):
        for other in gh("api", f"repos/{REPO}/issues/{n}/dependencies/{relation}"):
            print(f"---\n\n**{relation.replace('_', ' ').capitalize()}:**\n")
            show(issue(other["number"]), "##")
    spec = issue(SPEC)
    if lean:
        text = " ".join([ticket["title"], ticket["body"] or ""] + [c["body"] for c in ticket["comments"]])
        print(f"---\n\n**The spec (#{SPEC}), only what #{n} cites:**\n\n{cited(spec['body'], text)}")
    else:
        print("---\n\n**The spec:**\n")
        show(spec, "##")


if __name__ == "__main__":
    main()
