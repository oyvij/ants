#!/usr/bin/env python3
"""Ships Matt Pocock's Skills as his latest release has them, word for word (ADR 0024).

    scripts/matt-skills [<plugin>]

<plugin> is his plugin's folder, the one holding `.claude-plugin/plugin.json` and `skills/`: a clone of
https://github.com/mattpocock/skills, or by default the newest version Claude Code has cached in
~/.claude/plugins/cache/mattpocock/mattpocock-skills/.

Each Skill in SKILLS is copied whole into src/main/resources/shipped/skills/<his name>/, replacing what was there:
his SKILL.md with a licence comment under its frontmatter, his other files (`tests.md`, `CREDITS.md`, …), and his
LICENSE; not his `agents/` (Codex display names). It pins each file's SHA-256 in src/test/resources/matt-skills.sha256,
which MattSkillsTest checks, since CI has no copy of his release.

Then it prints what changed. What ties a Skill to a Run lives in the Assignments of the shipped Tasks that use it, so
read `git diff` against them: see .claude/skills/matt-skills/SKILL.md.
"""
import hashlib
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SHIPPED = ROOT / "src/main/resources/shipped/skills"
PINNED = ROOT / "src/test/resources/matt-skills.sha256"
CACHE = Path.home() / ".claude/plugins/cache/mattpocock/mattpocock-skills"

# His Skills Ants ships, under his skills/. Each ships under his name.
SKILLS = [
    "productivity/grilling",
    "engineering/to-spec",
    "engineering/to-tickets",
    "engineering/implement",
    "engineering/tdd",
    "engineering/code-review",
    "engineering/pr",
    "engineering/codebase-design",
]


def licensed(text, name, version):
    """His SKILL.md with the licence comment under its frontmatter; MattSkillsTest strips exactly this."""
    comment = (f"<!-- Matt Pocock's {name} Skill (https://github.com/mattpocock/skills, v{version}), word for word. "
               "Copyright (c) 2026 Matt Pocock. MIT License: see LICENSE beside this file. -->\n")
    match = re.match(r"\A---\n.*?\n---\n", text, flags=re.S)
    if not match:
        sys.exit(f"{name}/SKILL.md has no frontmatter")
    return text[:match.end()] + comment + text[match.end():]


def newest():
    versions = [p for p in CACHE.glob("*") if (p / "skills").is_dir()]
    if not versions:
        sys.exit(f"No cached plugin in {CACHE}; pass the folder of a clone of https://github.com/mattpocock/skills")
    return max(versions, key=lambda p: [int(n) if n.isdigit() else 0 for n in p.name.split(".")])


def main(args):
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return
    plugin = Path(args[0]).expanduser() if args else newest()
    version = re.search(r'"version":\s*"([^"]+)"', (plugin / ".claude-plugin/plugin.json").read_text()).group(1)
    print(f"Matt Pocock's skills v{version}, from {plugin}")
    pins = [f"# Matt Pocock's skills v{version}, as scripts/matt-skills copied them: SHA-256, two spaces, file."]
    shipped = set()
    for path in SKILLS:
        source = plugin / "skills" / path
        name = source.name
        if not (source / "SKILL.md").exists():
            print(f"  {name}: {path} is gone from his skills; find what replaced it in his CHANGELOG.md and fix SKILLS")
            continue
        shipped.add(name)
        target = SHIPPED / name
        old = {f.relative_to(target): f.read_bytes() for f in target.rglob("*") if f.is_file()} if target.exists() else None
        shutil.rmtree(target, ignore_errors=True)
        notes = []
        for file in sorted(source.rglob("*")):
            relative = file.relative_to(source)
            if file.is_dir() or relative.parts[0] == "agents":
                continue
            copy = target / relative
            copy.parent.mkdir(parents=True, exist_ok=True)
            data = file.read_bytes()
            pins.append(f"{hashlib.sha256(data).hexdigest()}  {name}/{relative}")
            if relative.name == "SKILL.md":
                data = licensed(data.decode(), name, version).encode()
            copy.write_bytes(data)
            if old is not None and relative not in old:
                notes.append(f"new file {relative}")
            elif old is not None and old[relative] != data and relative.name != "SKILL.md":
                notes.append(f"{relative} changed")
        shutil.copyfile(plugin / "LICENSE", target / "LICENSE")
        if old is None:
            notes.append("new: list it on the shipped Agents and Tasks that should use it")
        else:
            skill = Path("SKILL.md")
            if skill in old and re.sub(r"<!-- Matt Pocock's .*? -->\n", "", old[skill].decode(), count=1) != (source / "SKILL.md").read_text():
                notes.append("text changed")
            notes += [f"{r} is no longer his" for r in sorted(old) if r.name != "LICENSE" and not (target / r).exists()]
        for called in sorted(set(re.findall(r'Skill tool with "([\w-]+)"', (source / "SKILL.md").read_text())) - {s.split("/")[-1] for s in SKILLS}):
            notes.append(f'calls "{called}", which Ants doesn\'t ship')
        print(f"  {name}: " + ("; ".join(notes) or "same"))
    PINNED.write_text("\n".join(pins) + "\n")


if __name__ == "__main__":
    main(sys.argv[1:])
