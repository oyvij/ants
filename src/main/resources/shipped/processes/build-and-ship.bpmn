        <di:waypoint x="695" y="275"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="toyou" id="toyou_di">
        <di:waypoint x="720" y="300"/>
        <di:waypoint x="820" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="byproxy" id="byproxy_di">
