<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="set_up_vault" name="Set up Vault" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:documentation>init-vault asks its decisions as a Round, then proposes the Vault rules; it writes the rule Notes into the Vault only once the user approves them.</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="initvault" name="Set up the Vault rules" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="a-librarian" />
          <operaton:property name="ants.name.a-librarian" value="librarian" />
          <operaton:property name="ants.assignment" value="Set up or revise the Vault rules by following the init-vault Skill, asking its decisions as a Round, and write the rule Notes once the user approves them. `vault-format.md` and `leak-check.sh` are in the search-knowledge Skill's folder.&#10;&#10;Your one input, `approval`, is the user's answer to your last proposal, `{approved, comment}`, or null before you have proposed.&#10;&#10;If `approval.approved` is true, the user approved the rule Notes in `vault/proposal.md`: write the Notes staged in `vault/staging/` into the Vault, as `vault-format.md` says, after a last leak check, and answer `done` with `questions: []` and `written: true`.&#10;&#10;Otherwise:&#10;1. Read, as the Skill says.&#10;2. Ask every open decision in one Round: answer `done` with `questions` (one per decision, its id the decision's word in lowercase) and `written: false`. When the Vault already answers a decision, say what you found in `context` and recommend it. An answer that contradicts another, or `vault-format.md`, may take one more Round of one question each; otherwise every decision is settled.&#10;3. Once every decision is settled, stage the rule Notes in `vault/staging/`, as the Skill says. Write `vault/proposal.md` showing both Notes in full; the user reads it on an Approve page. Answer `done` with `questions: []`, `proposal: &quot;vault/proposal.md&quot;` and `written: false`.&#10;&#10;When the user sends the proposal back, you are resumed with their comment. Revise the staged Notes and `vault/proposal.md` from it, and answer `questions: []`, the proposal and `written: false` again." />
          <operaton:property name="ants.skills" value="k-init-vault, k-search-knowledge" />
          <operaton:property name="ants.name.k-init-vault" value="init-vault" />
          <operaton:property name="ants.name.k-search-knowledge" value="search-knowledge" />
          <operaton:property name="ants.vault" value="true" />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;:&quot;object&quot;,&quot;properties&quot;:{&quot;questions&quot;:{&quot;type&quot;:&quot;array&quot;,&quot;description&quot;:&quot;The Round: the decisions still open, empty once every one is settled.&quot;,&quot;items&quot;:{&quot;type&quot;:&quot;object&quot;,&quot;properties&quot;:{&quot;id&quot;:{&quot;type&quot;:&quot;string&quot;},&quot;title&quot;:{&quot;type&quot;:&quot;string&quot;},&quot;ask&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;One sentence. Code in backticks.&quot;},&quot;context&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;What the answer settles, briefly. Code in backticks.&quot;},&quot;recommendation&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;One sentence. Code in backticks.&quot;},&quot;why&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;One sentence.&quot;}},&quot;required&quot;:[&quot;id&quot;,&quot;title&quot;,&quot;ask&quot;,&quot;context&quot;,&quot;recommendation&quot;,&quot;why&quot;],&quot;additionalProperties&quot;:false}},&quot;proposal&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;format&quot;:&quot;path&quot;,&quot;description&quot;:&quot;The rule Notes in full for the user to approve, vault/proposal.md; only while written is false.&quot;},&quot;written&quot;:{&quot;type&quot;:&quot;boolean&quot;,&quot;description&quot;:&quot;True once the approved rule Notes are in the Vault.&quot;}},&quot;required&quot;:[&quot;written&quot;],&quot;additionalProperties&quot;:false}" />
          <operaton:property name="ants.resume" value="true" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="approval">${approverules}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>answered</bpmn:incoming>
      <bpmn:incoming>again</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="next" name="Asked? Written?" default="propose">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>asked</bpmn:outgoing>
      <bpmn:outgoing>written</bpmn:outgoing>
      <bpmn:outgoing>propose</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="answer" name="Answer the Round">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.user-task" value="answer-round" />
          <operaton:property name="ants.asker" value="initvault" />
        </operaton:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>asked</bpmn:incoming>
      <bpmn:outgoing>answered</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approverules" name="Approve the rule Notes">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.send-back" value="initvault" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="title">Approve the rule Notes</operaton:inputParameter>
          <operaton:inputParameter name="show">${initvault.output.proposal}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>propose</bpmn:incoming>
      <bpmn:outgoing>again</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end">
      <bpmn:incoming>written</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="initvault" />
    <bpmn:sequenceFlow id="f2" sourceRef="initvault" targetRef="next" />
    <bpmn:sequenceFlow id="asked" name="asked" sourceRef="next" targetRef="answer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not empty initvault.output.questions}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="written" name="written" sourceRef="next" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${empty initvault.output.questions and initvault.output.written}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="propose" name="proposed" sourceRef="next" targetRef="approverules" />
    <bpmn:sequenceFlow id="answered" sourceRef="answer" targetRef="initvault" />
    <bpmn:sequenceFlow id="again" sourceRef="approverules" targetRef="initvault" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="set_up_vault">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="initvault_di" bpmnElement="initvault">
        <dc:Bounds x="270" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="next_di" bpmnElement="next" isMarkerVisible="true">
        <dc:Bounds x="425" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answer_di" bpmnElement="answer">
        <dc:Bounds x="400" y="10" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approverules_di" bpmnElement="approverules">
        <dc:Bounds x="400" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="562" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="178" />
        <di:waypoint x="270" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="370" y="178" />
        <di:waypoint x="425" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asked_di" bpmnElement="asked">
        <di:waypoint x="450" y="153" />
        <di:waypoint x="450" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="written_di" bpmnElement="written">
        <di:waypoint x="475" y="178" />
        <di:waypoint x="562" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="propose_di" bpmnElement="propose">
        <di:waypoint x="450" y="203" />
        <di:waypoint x="450" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="answered_di" bpmnElement="answered">
        <di:waypoint x="400" y="50" />
        <di:waypoint x="320" y="50" />
        <di:waypoint x="320" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="again_di" bpmnElement="again">
        <di:waypoint x="400" y="300" />
        <di:waypoint x="320" y="300" />
        <di:waypoint x="320" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
