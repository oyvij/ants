<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="grill_by_proxy" name="Grill (by proxy)" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:documentation>The griller asks a Round at a time until it asks nothing; the answerer answers each Round from your Answer History and the Vault, and from Round 10 you do. Clone new repos clones any repo a Round names. Needs start-form field prompt, and the scout's brief.</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="grill" name="Grill" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="a-griller" />
          <operaton:property name="ants.name.a-griller" value="griller" />
          <operaton:property name="ants.skills" value="k-grilling" />
          <operaton:property name="ants.name.k-grilling" value="grilling" />
          <operaton:property name="ants.assignment" value="Grill the user on what this Run should build, until nothing is left to settle. The plan to grill is the prompt. Your inputs; paths are relative to the Run workspace:&#10;&#10;- `prompt`: what the user wants, in their words.&#10;- `brief`: the scout's brief: the repos and why, and what the Vault says.&#10;- `clones`: the repos cloned so far, `[{name, path, commit}]`.&#10;&#10;You only read: the brief, and the clones' code, docs, ADRs and glossary. You have no sub-agents, so find each fact yourself, before the Round that needs it.&#10;&#10;**Repos.** When the answers show the work needs a repo that wasn't in `clones` when you started, or may need it and nothing you have read rules it out, name it in `repos` by one of the Source map names your hand-off line lists, or by a git URL the user gave; never by a package, folder or product name you found in the code. Ants sends back any other name. Never take a repo you haven't read to need no change. Name every such repo again in each later Round, the last one included: `repos` is always the whole list. Each is cloned at `repos/&lt;name&gt;/` before your next Round, so read it then. One that never shows in `clones` was not cloned, and the Spec lists it as not checked. With none, `repos` is `[]`.&#10;&#10;When nothing is left to ask, the Run writes the Spec from the Run log, which holds every Round, and the user confirms the shared understanding by approving it." />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;repos&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;repo&quot;}, &quot;description&quot;: &quot;Every repo the work needs beyond the clones you started with, named again each Round: Source map names or git URLs the user gave; empty when none.&quot;}}, &quot;required&quot;: [&quot;repos&quot;], &quot;additionalProperties&quot;: false}" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="prompt">${prompt}</operaton:inputParameter>
          <operaton:inputParameter name="brief">${scout.output.brief}</operaton:inputParameter>
          <operaton:inputParameter name="clones">${clones}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>byagent</bpmn:incoming>
      <bpmn:incoming>byyou</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="clonenew" name="Clone new repos" operaton:type="external" operaton:topic="clone-repos">
      <bpmn:extensionElements>
        <operaton:inputOutput>
          <operaton:inputParameter name="repos">${grill.output.repos}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>cloned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="asked" name="Asked?" default="nothing">
      <bpmn:incoming>cloned</bpmn:incoming>
      <bpmn:outgoing>questions</bpmn:outgoing>
      <bpmn:outgoing>nothing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="capped" name="Round 10?" default="under">
      <bpmn:incoming>questions</bpmn:incoming>
      <bpmn:outgoing>cap</bpmn:outgoing>
      <bpmn:outgoing>under</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="answerer" name="Answer for me" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="a-answerer" />
          <operaton:property name="ants.name.a-answerer" value="answerer" />
          <operaton:property name="ants.assignment" value="Answer another Task's Round of questions for the user, as they would answer it themselves. The asking Task is resumed with your answers, and the Run goes on without the user.&#10;&#10;Your input, `questions`, is the Round: each question `{id, title, ask, context, recommendation, why}`. You only read.&#10;&#10;1. Read `INDEX.md` in the Answer History: one line per question the user answered themselves, its title linking to the Round's file. Open the Rounds whose questions are like these ones, and read what the user answered, and how: what they accepted, what they changed and in which direction.&#10;2. For what the Answer History doesn't settle, search the Vault by following the search-knowledge Skill: decisions, conventions and how the repos work.&#10;3. For each question, answer as the user would, in their words: concrete enough to build from.&#10;- Where the Answer History or the Vault says what the user would answer, give that, and say in `why` which Round or Note it came from.&#10;- Where neither does, but the recommendation fits what they say, give the recommendation, and say why it fits.&#10;- Where you can't tell, leave the question out: it gets its recommendation, stamped `recommended`, so the Report shows it was not your answer or the user's.&#10;Never invent a preference the user hasn't shown.&#10;&#10;Answer `done` with `answers: [{id, answer, why}]`." />
          <operaton:property name="ants.skills" value="k-search-knowledge" />
          <operaton:property name="ants.name.k-search-knowledge" value="search-knowledge" />
          <operaton:property name="ants.vault" value="true" />
          <operaton:property name="ants.answer-history" value="true" />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;:&quot;object&quot;,&quot;properties&quot;:{&quot;answers&quot;:{&quot;type&quot;:&quot;array&quot;,&quot;items&quot;:{&quot;type&quot;:&quot;object&quot;,&quot;properties&quot;:{&quot;id&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;The question's id.&quot;},&quot;answer&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;The answer, as the user would give it.&quot;},&quot;why&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;description&quot;:&quot;Which Round or Note it came from, or why the recommendation fits.&quot;}},&quot;required&quot;:[&quot;id&quot;,&quot;answer&quot;,&quot;why&quot;],&quot;additionalProperties&quot;:false},&quot;description&quot;:&quot;The questions you could answer; one left out gets its recommendation.&quot;}},&quot;required&quot;:[&quot;answers&quot;],&quot;additionalProperties&quot;:false}" />
          <operaton:property name="ants.asker" value="grill" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="questions">${grill.output.questions}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>under</bpmn:incoming>
      <bpmn:outgoing>byagent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="answerround" name="Answer the Round">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.user-task" value="answer-round" />
          <operaton:property name="ants.asker" value="grill" />
        </operaton:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>cap</bpmn:incoming>
      <bpmn:outgoing>byyou</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end">
      <bpmn:incoming>nothing</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="grill" />
    <bpmn:sequenceFlow id="f2" sourceRef="grill" targetRef="clonenew" />
    <bpmn:sequenceFlow id="cloned" sourceRef="clonenew" targetRef="asked" />
    <bpmn:sequenceFlow id="questions" name="yes" sourceRef="asked" targetRef="capped">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not empty grill.output.questions}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="nothing" name="no" sourceRef="asked" targetRef="end" />
    <bpmn:sequenceFlow id="cap" name="yes" sourceRef="capped" targetRef="answerround">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${runs.grill &gt;= 10}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="under" name="no" sourceRef="capped" targetRef="answerer" />
    <bpmn:sequenceFlow id="byagent" sourceRef="answerer" targetRef="grill" />
    <bpmn:sequenceFlow id="byyou" sourceRef="answerround" targetRef="grill" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="grill_by_proxy">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grill_di" bpmnElement="grill">
        <dc:Bounds x="270" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="clonenew_di" bpmnElement="clonenew">
        <dc:Bounds x="420" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="asked_di" bpmnElement="asked" isMarkerVisible="true">
        <dc:Bounds x="575" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="capped_di" bpmnElement="capped" isMarkerVisible="true">
        <dc:Bounds x="575" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answerer_di" bpmnElement="answerer">
        <dc:Bounds x="270" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answerround_di" bpmnElement="answerround">
        <dc:Bounds x="550" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="682" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="178" />
        <di:waypoint x="270" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="370" y="178" />
        <di:waypoint x="420" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="questions_di" bpmnElement="questions">
        <di:waypoint x="600" y="203" />
        <di:waypoint x="600" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="nothing_di" bpmnElement="nothing">
        <di:waypoint x="625" y="178" />
        <di:waypoint x="682" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cap_di" bpmnElement="cap">
        <di:waypoint x="600" y="325" />
        <di:waypoint x="600" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="under_di" bpmnElement="under">
        <di:waypoint x="575" y="300" />
        <di:waypoint x="370" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="byagent_di" bpmnElement="byagent">
        <di:waypoint x="320" y="260" />
        <di:waypoint x="320" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="byyou_di" bpmnElement="byyou">
        <di:waypoint x="550" y="420" />
        <di:waypoint x="230" y="420" />
        <di:waypoint x="230" y="200" />
        <di:waypoint x="270" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cloned_di" bpmnElement="cloned">
        <di:waypoint x="520" y="178" />
        <di:waypoint x="575" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
