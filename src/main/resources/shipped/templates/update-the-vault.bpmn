<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="update_the_vault" name="Update the Vault" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:documentation>update-knowledge proposes what the Run learned as Notes; until it says written, the user approves the Notes and it is resumed, writing them only once approved. Fill spec with the Run's Spec or proposal, and review with the implementers' review.</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="updateknowledge" name="Update the Vault" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="knowledge" />
          <operaton:property name="ants.assignment" value="Capture what this Run learned into the Vault by following the update-knowledge Skill: propose, revise, and write only once the user has approved. `vault-format.md` and `leak-check.sh` are in the search-knowledge Skill's folder.&#10;&#10;Your inputs:&#10;- `rounds`: the Run log, relative to the Run workspace: every Round, instruction and message.&#10;- `spec`: what the Run built, relative to the Run workspace (a Spec or a proposal), if any.&#10;- `review`: the implementers' review of their commits, if any: a summary, or their Results, each with the summary as `output.review`.&#10;- `clones`: the repos the Run cloned, `[{name, path, commit}]`.&#10;- `approval`: the user's answer to your last proposal, `{approved, comment}`, or null before you have proposed.&#10;&#10;The work to learn from is `rounds`, `spec`, `review`, and the commits on each clone's work branch. For a Note's `source`, name a clone by its Source map name.&#10;&#10;When no Vault is named above, the Run's Profile has none: answer `done` with `written: true` and nothing else.&#10;&#10;If `approval.approved` is true, the user approved the proposal in `vault/proposal.md`: write the Notes staged in `vault/staging/` into the Vault, as `vault-format.md` says, after a last leak check. Write nothing the proposal didn't name. Answer `done` with `written: true`.&#10;&#10;Otherwise, propose. When the Vault has no rules, answer `stuck`, needing: &quot;This Vault has no rules yet. Run the Set up Vault Process, then Continue.&quot; When nothing in the Run passes the Vault rules, write nothing and answer `done` with `written: true` and a summary saying so: there is nothing to approve. Else stage the Notes in `vault/staging/` and write the proposal to `vault/proposal.md`, which the user reads on an Approve page, and answer `done` with `proposal: &quot;vault/proposal.md&quot;` and `written: false`.&#10;&#10;When the user sends the proposal back, you are resumed with their comment. Revise the staged Notes and `vault/proposal.md` from it, show the whole proposal again in the file, and answer `written: false` again." />
          <operaton:property name="ants.skills" value="update-knowledge, search-knowledge" />
          <operaton:property name="ants.vault" value="true" />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;:&quot;object&quot;,&quot;properties&quot;:{&quot;proposal&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;format&quot;:&quot;path&quot;,&quot;description&quot;:&quot;The proposal for the user to approve, vault/proposal.md; only while written is false.&quot;},&quot;written&quot;:{&quot;type&quot;:&quot;boolean&quot;,&quot;description&quot;:&quot;True once the approved Notes are in the Vault, or when there was nothing to propose.&quot;}},&quot;required&quot;:[&quot;written&quot;],&quot;additionalProperties&quot;:false}" />
          <operaton:property name="ants.resume" value="true" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="rounds">run-log.md</operaton:inputParameter>
          <operaton:inputParameter name="spec">tickets/spec.md</operaton:inputParameter>
          <operaton:inputParameter name="review">${execution.getVariable('implement')}</operaton:inputParameter>
          <operaton:inputParameter name="clones">${clones}</operaton:inputParameter>
          <operaton:inputParameter name="approval">${approvenotes}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>again</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="written" name="Written?" default="no">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>yes</bpmn:outgoing>
      <bpmn:outgoing>no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approvenotes" name="Approve the Notes">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.send-back" value="updateknowledge" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="title">Approve the Notes</operaton:inputParameter>
          <operaton:inputParameter name="show">${updateknowledge.output.proposal}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>no</bpmn:incoming>
      <bpmn:outgoing>again</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end">
      <bpmn:incoming>yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="updateknowledge" />
    <bpmn:sequenceFlow id="f2" sourceRef="updateknowledge" targetRef="written" />
    <bpmn:sequenceFlow id="yes" name="yes" sourceRef="written" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${updateknowledge.output.written}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="no" name="no" sourceRef="written" targetRef="approvenotes" />
    <bpmn:sequenceFlow id="again" sourceRef="approvenotes" targetRef="updateknowledge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="update_the_vault">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="updateknowledge_di" bpmnElement="updateknowledge">
        <dc:Bounds x="270" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="written_di" bpmnElement="written" isMarkerVisible="true">
        <dc:Bounds x="425" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvenotes_di" bpmnElement="approvenotes">
        <dc:Bounds x="400" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="532" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="178" />
        <di:waypoint x="270" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="370" y="178" />
        <di:waypoint x="425" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="yes_di" bpmnElement="yes">
        <di:waypoint x="475" y="178" />
        <di:waypoint x="532" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="no_di" bpmnElement="no">
        <di:waypoint x="450" y="203" />
        <di:waypoint x="450" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="again_di" bpmnElement="again">
        <di:waypoint x="400" y="300" />
        <di:waypoint x="320" y="300" />
        <di:waypoint x="320" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
