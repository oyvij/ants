<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="cut_and_implement" name="Cut and implement" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:documentation>The planner cuts the Spec into Tickets; an implementer builds each Ticket in parallel, in its own worktree, once its blockers have landed. Needs the Spec, tospec's.</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="totickets" name="Cut the Tickets" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="planner" />
          <operaton:property name="ants.skills" value="to-tickets" />
          <operaton:property name="ants.assignment" value="Cut the Run's Spec into Tickets, as files in `tickets/issues/`, by following the to-tickets Skill. Your inputs; paths are relative to the Run workspace:&#10;&#10;- `spec`: the approved Spec, `tickets/spec.md`. It is the plan to break up.&#10;- `clones`: the repos cloned for the Run, `[{name, path, commit}]`. They are the codebase.&#10;&#10;You read the clones; you write only in `tickets/`.&#10;&#10;- **Quiz the user:** there is no one to ask before you publish. Put the three questions to yourself, fix the breakdown until each answer is yes, then publish. If you are resumed with a comment, that is the user's answer: revise the Tickets from it, and answer again.&#10;- **The tracker** is local files, laid out as `docs/agents/issue-tracker.md` in the Run workspace says. Where it differs from the local-ticket-template, the tracker doc wins: Tickets go in `tickets/issues/NN-&lt;slug&gt;.md`, never `.scratch/`; `Status:` and `Blocked by:` are plain lines, not bold, since Ants reads them; `Blocked by:` names Tickets by number only, such as `Blocked by: 01, 03`, or `Blocked by: none`; and each Ticket ends with `## Comments`.&#10;- **Blocking edges decide parallelism.** Every unblocked Ticket is built at once, each in its own worktree, and lands on the work branch when done. Block only where it is true, and know that two Tickets editing the same lines conflict when the second lands.&#10;- **ready-for-human:** a slice only the user can do, such as a decision, a credential or a manual check, is `ready-for-human`; its dependents wait until the user marks it done.&#10;&#10;Answer `done` with `tickets`: every Ticket's path, in number order." />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;tickets&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;path&quot;}, &quot;description&quot;: &quot;Every Ticket's path, tickets/issues/NN-&lt;slug&gt;.md, in number order.&quot;}}, &quot;required&quot;: [&quot;tickets&quot;], &quot;additionalProperties&quot;: false}" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="spec">${tospec.output.spec}</operaton:inputParameter>
          <operaton:inputParameter name="clones">${clones}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="implement" name="Implement" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="implementer" />
          <operaton:property name="ants.skills" value="implement, tdd, code-review, codebase-design" />
          <operaton:property name="ants.assignment" value="Build a Ticket of the Run's Spec, test-first in the clones, by following the implement Skill. Your inputs; paths are relative to the Run workspace:&#10;&#10;- `ticket`: the Ticket, `tickets/issues/NN-&lt;slug&gt;.md`. Build it, and only it.&#10;- `spec`: the Spec, `tickets/spec.md`: the Ticket's context.&#10;&#10;- **The code** is in the clones, `repos/&lt;name&gt;/` in your workspace, each on the branch you commit to. Commit there; never push, and never switch, rebase or reset a branch: Ants lands your commits and pushes them. Follow each clone's own `CLAUDE.md`, `AGENTS.md` and `CONTRIBUTING.md`, where they exist. With no clone in `repos/`, never make a repo (`git init`): Ants can't land it. Answer `stuck`, saying the Run has no repo and that a new one is named in the start form's Repos, as `owner/name`.&#10;- **Before you change anything**, note each clone's `HEAD` commit: it is the fixed point the review starts from. Set the Ticket's `Status:` line to `in-progress`. If it can't be built as written, set it to `needs-info`, add a comment under `## Comments` saying why, and answer `stuck` with the question.&#10;- **The pre-agreed seams** are those the Ticket's acceptance criteria and the Spec's Testing Decisions name. Confirming them with the user, as the tdd Skill asks, is done: there is no user to ask. Prefer the seams the repo's own tests already use, and write the seams down before the first test. Answer `stuck` only when the work names no behaviour you could test at any seam, saying what you would need.&#10;- **The suites:** run each touched repo's tests as its `CLAUDE.md`, `AGENTS.md` or `CONTRIBUTING.md` says; where they say nothing, run its whole suite once at the end.&#10;- **The review** with the code-review Skill runs from the fixed point, against the Ticket and the Spec. You are its user: give it the fixed point of each clone and the Ticket and the Spec by path; never ask, and never tell anyone to run `/setup-matt-pocock-skills`. Each clone with commits since its fixed point is reviewed, one with none left out; run git inside it, `repos/&lt;name&gt;/`. Its sub-agents are Subagents, started with the Agent tool. Fix each finding you agree with as a new commit, never amending the commits under review, and run the suites again.&#10;&#10;Answer `done` with `review`: the review's two reports, under `### Standards` and `### Spec`, saying what each found, what you fixed, and anything you left and why." />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;review&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;description&quot;: &quot;The review of the commits, in markdown: what the Standards and Spec reviews found, what was fixed and what was left.&quot;}}, &quot;required&quot;: [&quot;review&quot;], &quot;additionalProperties&quot;: false}" />
          <operaton:property name="ants.items-are-tickets" value="true" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="ticket">${ticket}</operaton:inputParameter>
          <operaton:inputParameter name="spec">${tospec.output.spec}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics operaton:collection="${totickets.output.tickets}" operaton:elementVariable="ticket" />
    </bpmn:serviceTask>
    <bpmn:endEvent id="end">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="totickets" />
    <bpmn:sequenceFlow id="f2" sourceRef="totickets" targetRef="implement" />
    <bpmn:sequenceFlow id="f3" sourceRef="implement" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="cut_and_implement">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="totickets_di" bpmnElement="totickets">
        <dc:Bounds x="270" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="implement_di" bpmnElement="implement">
        <dc:Bounds x="420" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="572" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="178" />
        <di:waypoint x="270" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="370" y="178" />
        <di:waypoint x="420" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="520" y="178" />
        <di:waypoint x="572" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
