<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="grill_you_answer" name="Grill (you answer)" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:documentation>The griller asks a Round at a time until it asks nothing; you answer each Round, and Clone new repos clones any repo a Round names. Needs start-form field prompt, and the scout's brief.</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="grill" name="Grill" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="griller" />
          <operaton:property name="ants.skills" value="grilling" />
          <operaton:property name="ants.assignment" value="Grill the user with the grilling Skill on what this Run should build, until nothing is left to settle. The plan to grill is the prompt. Your inputs; paths are relative to the Run workspace:&#10;&#10;- `prompt`: what the user wants, in their words.&#10;- `brief`: the scout's brief: the repos and why, and what the Vault says.&#10;- `clones`: the repos cloned so far, `[{name, path, commit}]`.&#10;&#10;You only read: the brief, and the clones' code, docs, ADRs and glossary. You have no sub-agents, so find each fact yourself, before the Round that needs it.&#10;&#10;**Repos.** When the answers show the work needs a repo that wasn't in `clones` when you started, or may need it and nothing you have read rules it out, name it in `repos` by one of the Source map names your hand-off line lists, or by a git URL the user gave; never by a package, folder or product name you found in the code. Ants sends back any other name. Never take a repo you haven't read to need no change. Name every such repo again in each later Round, the last one included: `repos` is always the whole list. Each is cloned at `repos/&lt;name&gt;/` before your next Round, so read it then. One that never shows in `clones` was not cloned, and the Spec lists it as not checked. With none, `repos` is `[]`.&#10;&#10;When nothing is left to ask, the Run writes the Spec from the Run log, which holds every Round, and the user confirms the shared understanding by approving it." />
          <operaton:property name="ants.result-schema" value="{&quot;type&quot;: &quot;object&quot;, &quot;properties&quot;: {&quot;repos&quot;: {&quot;type&quot;: &quot;array&quot;, &quot;items&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;repo&quot;}, &quot;description&quot;: &quot;Every repo the work needs beyond the clones you started with, named again each Round: Source map names or git URLs the user gave; empty when none.&quot;}}, &quot;required&quot;: [&quot;repos&quot;], &quot;additionalProperties&quot;: false}" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="prompt">${prompt}</operaton:inputParameter>
          <operaton:inputParameter name="brief">${scout.output.brief}</operaton:inputParameter>
          <operaton:inputParameter name="clones">${clones}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>answered</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="clonenew" name="Clone new repos" operaton:type="external" operaton:topic="clone-repos">
      <bpmn:extensionElements>
        <operaton:inputOutput>
          <operaton:inputParameter name="repos">${grill.output.repos}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="asked" name="Asked?" default="nothing">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>questions</bpmn:outgoing>
      <bpmn:outgoing>nothing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="answerround" name="Answer the Round">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.user-task" value="answer-round" />
          <operaton:property name="ants.asker" value="grill" />
        </operaton:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>questions</bpmn:incoming>
      <bpmn:outgoing>answered</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end">
      <bpmn:incoming>nothing</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="grill" />
    <bpmn:sequenceFlow id="f2" sourceRef="grill" targetRef="clonenew" />
    <bpmn:sequenceFlow id="f3" sourceRef="clonenew" targetRef="asked" />
    <bpmn:sequenceFlow id="questions" name="yes" sourceRef="asked" targetRef="answerround">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not empty grill.output.questions}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="nothing" name="no" sourceRef="asked" targetRef="end" />
    <bpmn:sequenceFlow id="answered" sourceRef="answerround" targetRef="grill" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="grill_you_answer">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grill_di" bpmnElement="grill">
        <dc:Bounds x="270" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="clonenew_di" bpmnElement="clonenew">
        <dc:Bounds x="420" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="asked_di" bpmnElement="asked" isMarkerVisible="true">
        <dc:Bounds x="575" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answerround_di" bpmnElement="answerround">
        <dc:Bounds x="420" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="682" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="178" />
        <di:waypoint x="270" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="370" y="178" />
        <di:waypoint x="420" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="520" y="178" />
        <di:waypoint x="575" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="questions_di" bpmnElement="questions">
        <di:waypoint x="600" y="203" />
        <di:waypoint x="600" y="320" />
        <di:waypoint x="520" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="nothing_di" bpmnElement="nothing">
        <di:waypoint x="625" y="178" />
        <di:waypoint x="682" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="answered_di" bpmnElement="answered">
        <di:waypoint x="420" y="320" />
        <di:waypoint x="320" y="320" />
        <di:waypoint x="320" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
