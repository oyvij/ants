@param pauses: Map<String, String>
@param csrf: org.springframework.security.web.csrf.CsrfToken
@for((cli, until) in pauses)<form method="post" action="/pauses/${cli}"><b>⏸ ${cli} paused until ${until}</b><br>Usage limit <input type="hidden" name="${csrf.parameterName}" value="${csrf.token}"><button>Try now</button></form>@endfor
