@import ants.Settings
@param form: ants.SettingsForm
@param file: String
@param message: String? = null
@param passwordFromEnv: Boolean
@param login: ants.ClaudeLogin
@param home: String
@param address: String
@param update: ants.UpdateNotice
@param docker: Boolean
@param maps: Map<String, Pair<String, String>>
@param instructions: Map<String, ants.ProfileInstructions>
@param setUp: Map<String?, String>
@param colorScheme: String = "light dark"
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Settings · Ants</title>
    <script src="/settings.js" defer></script>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Settings</h1><div class="acts"><button class="primary" form="settings" name="action" value="save">Save</button></div>
    <div class="sub">Written to <code>${file}</code>. A hand edit to it shows here.</div></div>
@if(message != null)<p role="alert">${message}</p>@endif
<form method="post" action="/settings" id="settings" class="settings">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <div class="grid2"><div class="card"><h3>Claude login</h3>
        <div class="kv"><span class="k">Status</span><span>@if(login.loggedIn)<span class="pill p-ready">Logged in</span> ${login.method}@else<span class="pill p-failed">Not logged in</span>@endif</span>
            <span class="k">Config folder</span><span><code>${login.folder.toString()}</code></span>
            <span class="k">Usage</span><span>@if(login.usage.isEmpty())<span class="muted small">No usage reported yet; it shows after an Agent Task runs.</span>@else
@for(usage in login.usage)<div class="meter"><span>${usage.window}</span><div class="track"><div class="fill${if (usage.percent > 75) " hot" else ""}" style="width:${usage.percent}%"></div></div><b>${usage.percent}%</b></div>@endfor
@if(login.resets.isNotEmpty())<div class="help">${login.resets}</div>@endif@endif</span></div>
@if(login.apiKeySource != null)
        <p role="alert">An API key is in use (apiKeySource: ${login.apiKeySource}). Agents run on the subscription login only:
            remove the key from Ants' Claude login and log in again.</p>
@endif
        <div class="subsec"><b class="small">Log in again</b><div class="help">Agents run on Ants' own Claude login, never yours. Run this in a terminal, then press <b>Check login</b>.</div>
            <div class="cmd"><code>${login.command}</code><button type="button" data-copy>Copy</button></div>
            <button name="action" value="login">Check login</button></div>
        <div class="subsec"><label class="small" for="agent-tasks">Agent Tasks at once</label><div class="help">Live CLI processes across all Runs. More wait as <b>Queued</b>.</div>
            <input type="number" min="1" id="agent-tasks" name="agent-tasks" value="${form.agentTasks}" placeholder="e.g. 3" class="num"></div>
        <div class="subsec"><label class="small" for="subagent-depth">Subagent depth</label><div class="help">How deep claude's Subagents may nest. At 1 a Task's Subagents start none of their own.</div>
            <input type="number" min="1" id="subagent-depth" name="subagent-depth" value="${form.subagentDepth}" placeholder="e.g. 1" class="num"></div>
        <div class="subsec"><label class="small" for="retries">Retries</label><div class="help">How often a <b>[failed]</b> Agent Task retries one level up before it waits on you. 3 when empty.</div>
            <input type="number" min="0" id="retries" name="retries" value="${form.retries}" placeholder="e.g. 3" class="num"></div></div>
    <div class="card"><h3>Commands</h3>
@for(cli in Settings.CLIS)
        <div class="fld"><label class="f" for="${cli}.path">${cli}</label><input class="mono" id="${cli}.path" name="${cli}.path" value="${form.paths[cli]}" placeholder="e.g. /opt/homebrew/bin/${cli}"></div>
@endfor
        <p class="row"><button name="action" value="detect">Detect</button> <span class="muted small">Finds them through your login shell.</span></p>
@for(cli in Settings.AI_CLIS)
        <div class="subsec"><b class="small">How Ants runs ${cli}</b>
            <div class="fld"><label class="f" for="${cli}.command">Command</label><div class="help">Ants appends its flags, for example <span class="eg">nono run --profile ${cli} -- ${cli}</span></div>
                <input class="mono" id="${cli}.command" name="${cli}.command" value="${form.commands[cli]}" placeholder="${cli}'s path"></div>
            <div class="fld"><label class="f" for="${cli}.env">Environment allow-list</label>
                <input class="mono" id="${cli}.env" name="${cli}.env" value="${form.envs[cli]}" placeholder="${Settings.DEFAULT_ENV.joinToString(" ")}"></div></div>
@endfor
        <div class="subsec"><label class="small" for="varde-config">Varde's config.toml</label><div class="help">Fills a command and allow-list from its <code>[ai]</code>.</div>
            <div class="row"><input class="grow mono" id="varde-config" name="varde-config" value="${form.vardeConfig}" placeholder="e.g. ~/.varde/config.toml"><button name="action" value="varde">Fill from Varde</button></div></div></div></div>

    <div class="card"><h3>Vaults</h3><div class="help">Profiles below pair them with Source maps; with no Profile, every Run uses the default.</div>
        @template.named(list = "vaults", default = "default-vault", named = form.vaults, setUp = setUp, nameExample = "work", pathExample = "~/notes/work")</div>
    <div class="card"><h3>Source maps</h3><div class="help">Profiles below pair them with Vaults; with no Profile, every Run uses the default.</div>
        @template.named(list = "source-maps", default = "default-source-map", named = form.sourceMaps, edit = maps.keys.toList(), nameExample = "work", pathExample = "~/notes/work/source-map.md")</div>

    <div class="card"><h3>Profiles</h3><div class="help">Each pairs a Vault with a Source map, such as one for work and one for private repos; its Instructions hold what
        its Runs' Agents get and their Verbosity. A Process can name its Profile, and the start form picks the Run's. With none, every Run uses the default Vault and Source map.
        A new Vault or Source map is offered here once saved.</div>
        <div class="listed">
@for((i, row) in form.shownProfiles.withIndex())
            <div class="row" hidden="${row.name.isEmpty()}">
                <input type="hidden" name="profiles[${i}].was" value="${row.was}">
                <input type="hidden" name="profiles[${i}].verbosity" value="${row.verbosity.value}">
                <label class="cap name">Name<input name="profiles[${i}].name" value="${row.name}" placeholder="e.g. private"></label>
                <label class="cap grow">Vault<select name="profiles[${i}].vault"><option value="">Vault</option>
@for(name in (form.vaults.rows.map { it.first } + row.vault).filter(String::isNotEmpty).distinct())
                    <option selected="${name == row.vault}">${name}</option>
@endfor
                </select></label>
                <label class="cap grow">Source map<select name="profiles[${i}].source-map"><option value="">Source map</option>
@for(name in (form.sourceMaps.rows.map { it.first } + row.sourceMap).filter(String::isNotEmpty).distinct())
                    <option selected="${name == row.sourceMap}">${name}</option>
@endfor
                </select></label>
                <label class="row small"><input type="radio" name="default-profile" value="${i}" checked="${i == form.defaultProfile}"> default</label>
@if(row.name in instructions)
                <button type="button" data-edit="instructions-${instructions.keys.indexOf(row.name)}">${if (instructions.getValue(row.name).has) "Instructions" else "Add instructions"}</button>
@endif
                <button type="button" class="ghost" data-remove>Remove</button>
            </div>
@endfor
            <button type="button" data-add>＋ Add</button></div></div>

    <div class="card"><h3>Secrets</h3><div class="help">Values such as a registry token, which Protected Commands run with and Agents never see.
        A value is kept in <code>secrets.yaml</code>, never shown again; left blank, the saved one stays. Each variable name is the
        variable the command reads the value from, such as <span class="eg">YARN_NPM_AUTH_TOKEN</span>.</div>
        <div class="listed">
@for((i, row) in form.shownSecrets.withIndex())
            <div class="row" hidden="${row.label.isEmpty()}">
                <input type="hidden" name="secrets[${i}].was" value="${row.was}">
                <label class="cap name">Label<input name="secrets[${i}].label" value="${row.label}" placeholder="e.g. npm"></label>
                <label class="cap name">Value<input type="password" name="secrets[${i}].value" placeholder="${if (row.set) "••••" else if (row.was.isNotEmpty()) "Not set yet" else "e.g. npm_a1b2c3"}" autocomplete="new-password"></label>
                <label class="cap grow">Variable names<input class="mono" name="secrets[${i}].names" value="${row.names}" placeholder="e.g. NPM_TOKEN"></label>
                <button type="button" class="ghost" data-remove>Remove</button>
            </div>
@endfor
            <button type="button" data-add>＋ Add</button></div></div>

    <div class="card"><h3>Protected Commands</h3><div class="help">A Protected Command is a command that needs Secrets. Agents run it only through Ants, never through Bash,
        so a command that needs no Secret, such as <span class="eg">cargo</span> or <span class="eg">gh</span>, doesn't belong here. Ants runs it, with any
        arguments, in the Agent's Run workspace, with the Secrets picked, and the Agent gets the output, every Secret masked. A command is
        picked by how it starts, such as <span class="eg">yarn</span> or <span class="eg">mvn deploy</span>. A new Secret is offered here once saved.</div>
        <div class="listed">
@for((i, row) in form.shownProtectedCommands.withIndex())
            <div class="row" hidden="${row.prefix.isEmpty()}">
                <label class="cap grow">Command prefix<input class="mono" name="protected-commands[${i}].prefix" value="${row.prefix}" placeholder="e.g. yarn install"></label>
                <label class="cap grow">Secrets<select multiple name="protected-commands[${i}].secrets">
@for(label in (form.secrets.map { it.label } + row.secrets).distinct())
                    <option selected="${label in row.secrets}">${label}</option>
@endfor
                </select></label>
                <button type="button" class="ghost" data-remove>Remove</button>
            </div>
@endfor
            <button type="button" data-add>＋ Add</button></div></div>

    <div class="grid2">
@for((name, label, help) in listOf(Triple("agent-folders", "Agent folders", "Every <code>*.md</code> directly inside is an Agent."), Triple("skill-folders", "Skill folders", "Every folder holding a <code>SKILL.md</code>, at any depth, is a Skill.")))
        <div class="card"><h3>${label}</h3><div class="help">$unsafe{help}</div><div class="listed">
            <div class="row"><label class="cap grow">Folder<input class="mono" placeholder="e.g. ~/.ants/${name.removeSuffix("-folders")}s" value="${home}/${name.removeSuffix("-folders")}s" disabled></label><span class="muted small nowrap">Ants' own, always</span></div>
@for(folder in (if (name == "agent-folders") form.agentFolders else form.skillFolders).lines().filter(String::isNotBlank) + "")
            <div class="row" hidden="${folder.isEmpty()}"><label class="cap grow">Folder<input class="mono" name="${name}" value="${folder}" placeholder="e.g. ~/.varde/ai/${name.removeSuffix("-folders")}s"></label><button type="button" class="ghost" data-remove>Remove</button></div>
@endfor
            <button type="button" data-add>＋ Add folder</button></div></div>
@endfor
    </div>

    <div class="grid2"><div class="card"><h3>Shipped with Ants</h3>
        <label class="row"><input type="checkbox" name="hide-shipped" checked="${form.hideShipped}"> Hide the Processes, Skills and Agents Ants ships</label>
        <div class="help">For a clean slate: they leave every list and picker, and nothing is deleted. Processes that already use them, and Runs already going, keep working.</div></div></div>

    <div class="grid2"><div class="card"><h3>So far</h3>
        <label class="row"><input type="checkbox" name="so-far" checked="${form.soFar}"> Write a So far paragraph on running Tasks</label>
        <div class="help">haiku rewrites each Task's new Transcript lines every couple of minutes, in a session of its own.</div></div>
    <div class="card"><h3>Theme</h3>
        <div class="row">
@for(theme in listOf("system", "light", "dark"))
            <label class="row"><input type="radio" name="theme" value="${theme}" checked="${theme == form.theme}"> ${theme}</label>
@endfor
        </div><div class="help">System follows the computer's light or dark mode.</div></div></div>

    <div class="grid2"><div class="card"><h3>Server</h3>
        <div class="fld"><label class="f" for="address">Address</label><div class="help">Set with SERVER_ADDRESS when Ants starts. Ants refuses a non-loopback address while the password is the default. &nbsp;e.g. <span class="eg">127.0.0.1:7323</span></div>
            <input class="mono" id="address" placeholder="e.g. 127.0.0.1:7323" value="${address}" readonly></div>
        <div class="fld"><label class="f" for="password">Password</label>
@if(passwordFromEnv)
            <div class="help">ANTS_PASSWORD or ANTS_PASSWORD_FILE sets the password, over this file's; change it there.</div>
@else
            <div class="help">Takes effect at the next login.</div>
            <input type="password" id="password" name="password" autocomplete="new-password" placeholder="Change from admin">
@endif
        </div></div>
    <div class="card"><h3>Updates</h3>
        !{val newer = update.newer}
        <p class="small">Running v${shell.version}.@if(newer == null && update.unreachable) Couldn't check for a newer Ants: the release list didn't answer.@elseif(newer == null) Up to date.@elseif(update.installed == newer) Ants ${newer} installed; <code>ants restart</code> to use it.@elseif(update.downloading) Downloading Ants ${newer}…@elseif(docker) Ants ${newer} is available; pull the new image.@else Ants ${newer} is available. <button formaction="/updates/${newer}">Update</button>@endif</p>
@if(update.failed != null)
        <p role="alert">Update failed: ${update.failed}</p>
@endif
        <label class="row"><input type="checkbox" name="prereleases" checked="${form.prereleases}"> Follow beta versions</label>
        <button name="action" value="updates">Check now</button></div></div>
</form>
@for((i, map) in maps.entries.withIndex())
<dialog class="modal source-map" id="source-map-${i}">
    <form method="dialog" class="mh"><b>${map.key}</b><code class="small">${map.value.first}</code><span class="sp"></span><span class="muted small">Esc to close</span><button class="ghost" title="Close" aria-label="Close">✕</button></form>
    <form method="post" action="/settings/source-map" class="mb">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        <input type="hidden" name="name" value="${map.key}">
        <label class="f" for="source-map-text-${i}">Source map</label>
        <div class="help">One repo per line, <code>- &lt;name&gt;: &lt;local path&gt; (&lt;git remote&gt;)</code>; Processes and Tasks name it by its name. Other lines are ignored.</div>
        <textarea class="mono" id="source-map-text-${i}" name="text" rows="14" placeholder="e.g. - ants: ~/code/ants (git@github.com:oyvij/ants.git)&#10;- web: ~/code/web (https://github.com/acme/web.git)">${map.value.second}</textarea>
        <div class="go"><button class="primary">Save</button></div>
    </form>
</dialog>
@endfor
@for((i, profile) in instructions.entries.withIndex())
<dialog class="modal instructions" id="instructions-${i}">
    <form method="dialog" class="mh"><label for="instructions-text-${i}">Optional instructions</label><span class="pill p-quiet" title="Profile">${profile.key}</span><span class="sp"></span><span class="muted small">Esc to close</span><button class="ghost" title="Close" aria-label="Close">✕</button></form>
    <form method="post" action="/settings/instructions" class="mb">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        <input type="hidden" name="name" value="${profile.key}">
        <div class="help">Every Agent in this Profile's Runs gets this as its <code>AGENTS.md</code>. Plain markdown only - images and other rich content don't reach the Agents.</div>
        <textarea id="instructions-text-${i}" name="text" rows="14" placeholder="e.g. # Commits&#10;Use conventional commits, such as feat: add login.&#10;&#10;# Code&#10;Prefer early returns over nested branches." data-markdown>${profile.value.text}</textarea>
        <div class="go"><span class="muted small" id="verbosity-${i}">Verbosity</span>
            <div class="seg" role="radiogroup" aria-labelledby="verbosity-${i}" title="How much the Agents in this Profile's Runs write for you to read; a Run's start form can change it">
@for(level in ants.Verbosity.entries)
                <label><input type="radio" name="verbosity" value="${level.value}" checked="${level == profile.value.verbosity}">${level.label}</label>
@endfor
            </div><button class="primary">Save</button></div>
    </form>
</dialog>
@endfor
</main>
</body>
</html>
