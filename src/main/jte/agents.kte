@param agents: List<ants.AgentRow>
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Agents · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Agents</h1>
    <div class="acts">
        <form method="post" action="/agents/import" enctype="multipart/form-data"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label class="btn" title="Import one agent file into the New Agent form">Import…<input type="file" name="file" accept=".md" required hidden onchange="this.form.submit()"></label></form>
        <a class="btn primary" href="/agents/new">New Agent</a>
    </div>
    <div class="sub">From the folders in <a href="/settings">Settings</a>. Ants writes only into <code>~/.ants/agents</code>; the rest are read-only, with Copy.</div></div>
@if(error != null)<p role="alert">${error}</p>@endif
<table class="library">
    <thead><tr><th>Name</th><th>CLI · model</th><th>Skills</th><th>Description</th><th>Folder</th></tr></thead>
    <tbody>
@for(row in agents)
    <tr class="click" data-href="/agents/${row.agent.name}"><td><b><a href="/agents/${row.agent.name}">${row.agent.name}</a></b>@if(row.vault) <span class="tag t-vault">Vault</span>@endif</td><td class="small">${row.agent.cli} · ${row.agent.model ?: "default"}</td><td class="small">@for(skill in row.agent.skills)@if(skill == "*")every Skill@else<a href="/skills/${skill}">${skill}</a>@endif@if(skill != row.agent.skills.last()) @endif@endfor</td><td class="small">${row.agent.description}</td><td class="muted small">${row.where}</td></tr>
@endfor
    </tbody>
</table>
</main>
</body>
</html>
