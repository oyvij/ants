@import ants.AgentForm
@param form: AgentForm
@param models: ants.Models
@param action: String
@param item: String?
@param draft: ants.DraftHead? = null
@param readOnly: Boolean
@param where: String? = null
@param skills: List<ants.Skill> = emptyList()
@param scripts: List<String> = emptyList()
@param dependents: ants.Dependents?
@param error: String? = null
@param use: Boolean = false
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
!{val skillIcon = """<svg class="i" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>"""}
!{val claude = form.cli == "claude"}
!{val deprecated = models.deprecated(form.model)}
!{val other = claude && form.model.isNotEmpty() && models.unlisted(form.model)}
!{val othersOn = AgentForm.OTHER_TOOLS.keys.count { it in form.tools }}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${if (item == null) "New Agent" else form.name} · Agents · Ants</title>
</head>
<body>
@if(!use)
@template.nav(shell = shell)
@endif
<main>
@if(!use)<div class="crumbs"><a href="/agents">Agents</a> / ${form.name.ifEmpty { "New" }}</div>@endif
<div class="ph"><h1><span class="ent ent-agent"><svg class="i" viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V4M9 13v1M15 13v1"/></svg>${if (item == null) "New Agent" else form.name}</span></h1>
@if(draft != null)
    @template.drafthead(draft = draft)
@endif
    <div class="acts">
@if(readOnly)
        <span class="muted small">Read-only (${where})</span>
        <form method="post" action="${action}/copy"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Copy</button></form>
@else
@if(draft?.state == ants.DraftState.CHANGED)
        <form method="post" action="${action}/discard" data-leaves-draft><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Discard Draft</button></form>
@endif
@if(item != null)
        <form method="post" action="${action}/delete" data-leaves-draft><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Delete</button></form>
@endif
        <button class="primary" form="agent">Publish</button>
@endif
    </div>
@if(dependents != null)    <div class="sub">@template.usedby(dependents = dependents, none = "no Process")</div>@endif
</div>
@if(error != null)<p role="alert">${error}</p>@endif
<form id="agent" class="agent" method="post" action="${action}" data-autosave="${draft?.endpoint}" data-version="${draft?.version?.toString()}" data-leaves-draft>
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(use)
    <input type="hidden" name="use">
@endif
    <fieldset disabled="${readOnly}">
    <div class="card"><h3>Who it is</h3>
        <div class="grid2">
            <div class="fld"><label class="f" for="name">Name</label><div class="help">How Tasks name it: lowercase letters, digits and hyphens, unique across all Agent folders. &nbsp;e.g. <span class="eg">implementer</span></div>
                <input id="name" name="name" value="${form.name}" placeholder="e.g. implementer" required pattern="[a-z0-9][a-z0-9\-]*"></div>
            <div class="fld"><label class="f" for="description">Description</label><div class="help">One line: what this Agent is for. Shown in the modeler's Agent dropdown. &nbsp;e.g. <span class="eg">Implements one ticket, test first, and commits.</span></div>
                <input id="description" name="description" value="${form.description}" placeholder="e.g. Implements one ticket, test first, and commits."></div>
            <div class="fld"><label class="f" for="cli">CLI</label><div class="help">Which AI CLI runs it, on Ants' own login.</div>
                <select id="cli" name="cli">
@for(cli in AgentForm.CLIS)
                    <option value="${cli}" selected="${cli == form.cli}">${cli}</option>
@endfor
                </select></div>
            <div class="fld">
                <fieldset data-cli="claude" disabled="${!claude}">
                    <label class="f" for="model">Model</label><div class="help">An alias always runs the newest of its family; a fixed version stays put until it retires.</div>
                    <select id="model" name="model">
                        <option value="" selected="${form.model.isEmpty()}">default · whatever the CLI picks</option>
                        <optgroup label="Always the newest">
@for(alias in models.aliases)
                            <option value="${alias.key}" selected="${claude && form.model == alias.key}">${alias.key} · newest ${alias.key.replaceFirstChar(Char::uppercase)}${alias.value?.let { ", now " + models.label(it) }.orEmpty()}</option>
@endfor
                        </optgroup>
                        <optgroup label="A fixed version">
@for(model in models.all.filter { it.retires == null })
                            <option value="${model.id}" selected="${claude && form.model == model.id}">${model.label} · ${model.id}</option>
@endfor
                        </optgroup>
                        <optgroup label="Deprecated: still runs, retiring">
@for(model in models.all.filter { it.retires != null })
                            <option value="${model.id}" selected="${claude && form.model == model.id}">${model.label} · ${model.id} · retires ${model.retires}</option>
@endfor
                        </optgroup>
                        <option value="other" selected="${other}">Other model ID…</option>
                    </select>
                    <label class="f other" for="model-other">Other model ID</label>
                    <input class="mono other" id="model-other" name="model-other" value="${if (other) form.model else ""}" placeholder="e.g. claude-opus-6">
                    <div class="help other">Not on Anthropic's list yet. The check before a Run tries it once on your login.</div>
@if(deprecated != null)
                    <div class="warn">Deprecated: it retires ${deprecated.retires}. Pick a newer version, or <b>opus</b> / <b>sonnet</b> to always get the newest.</div>
@endif
                    <div class="help checked">From Anthropic's public model list, refreshed with Ants' update check (last ${models.lastChecked ?: "never: the list Ants shipped with"}). <button class="ghost small" form="models-check">Check now</button></div>
                </fieldset>
                <fieldset data-cli="codex" disabled="${claude}">
                    <label class="f" for="codex-model">Model</label>
                    <input class="mono" id="codex-model" name="model" value="${if (claude) "" else form.model}" placeholder="e.g. gpt-5-codex">
                    <div class="help checked">codex's model ID, as <code>codex -m</code> takes it; empty for codex's default.</div>
                </fieldset></div>
        </div>
        <div class="fld"><label class="f" for="add-skill">Skills it may use</label><div class="help">The Skills this Agent may use, or <code>*</code> for every Skill. A Task lists the ones it allows, or allows them all; the modeler only offers these. &nbsp;e.g. <span class="eg">implement, tdd</span></div>
            <div class="chipsel">
@for(skill in ants.words(form.skills))
                <span class="c">$unsafe{skillIcon}${if (skill == "*") "every Skill" else skill}<input type="hidden" name="skills" value="${skill}">@if(!readOnly)<button type="button" title="Remove">×</button>@endif</span>
@endfor
@if(!readOnly)
                <input id="add-skill" name="skills" list="skill-list" placeholder="Add a Skill, e.g. implement" autocomplete="off">
@endif
            </div>
            <datalist id="skill-list">
@for(skill in skills)
                <option value="${skill.name}">${skill.description}</option>
@endfor
            </datalist>
            <template id="skill-chip"><span class="c">$unsafe{skillIcon}<input type="hidden" name="skills"><button type="button" title="Remove">×</button></span></template>
        </div>
        <fieldset data-cli="claude" disabled="${!claude}">
            <div class="fld"><label class="f">Offer as a Subagent</label><div class="help">Other Agents may start it as a Subagent, through their Agent tool. claude Agents only.</div>
                <label class="tick"><input type="checkbox" name="subagent" checked="${form.subagent}"> Offer it as a Subagent</label></div>
            <div class="fld"><label class="f">Scripts it may call</label><div class="help">Each ticked Script is a tool the Agent calls with inputs, getting back the exit code, the masked output and the payload. It never sees the code or a Secret. A Task can narrow them. claude Agents only.</div>
@if(scripts.isEmpty())
                <div class="help">No Scripts yet. <button class="ghost small" form="new-script">New Script</button></div>
@endif
@for(script in scripts)
                <label class="tick"><input type="checkbox" name="scripts" value="${script}" checked="${script in form.scriptList}"> ${script}</label>
@endfor
            </div>
        </fieldset>
    </div>
    <div class="card"><h3>What it may do</h3>
        <fieldset data-cli="claude" disabled="${!claude}">
            <div class="help">Tick each tool this Agent may use. Anything unticked is refused: an Agent without <b>Edit</b> and <b>Write</b> can't change code, whatever its Skills say.</div>
@for(group in AgentForm.GROUPS)
            <div class="tgroup">${group.key}</div>
@for(tool in group.value)
            @template.toolrow(form = form, name = tool.name, tool = tool, readOnly = readOnly)
@endfor
@endfor
            <details class="others" open="${othersOn > 0}"><summary class="small">Claude Code's other ${AgentForm.OTHER_TOOLS.size} tools${if (othersOn > 0) " ($othersOn ticked)" else ""}: usually off for Agents, and why</summary>
@for(other in AgentForm.OTHER_TOOLS)
                @template.toolrow(form = form, name = other.key, warn = other.value, readOnly = readOnly)
@endfor
            </details>
            <div class="added" hidden="${form.custom.isEmpty()}"><div class="tgroup">Added by you</div>
@for(tool in form.custom)
                @template.toolrow(form = form, name = tool, warn = AgentForm.note(tool), readOnly = readOnly, added = true)
@endfor
            </div>
@if(!readOnly)
            <label class="f" for="other-tools">Add a tool</label>
            <div class="row add-tool" data-mcp="${AgentForm.MCP_NOTE}" data-unknown="${AgentForm.UNKNOWN_NOTE}"><input class="mono" id="other-tools" name="other-tools" placeholder="A tool Ants doesn't list yet, by name: e.g. mcp__github__get_issue"><button type="button">＋ Add tool</button></div>
@endif
        </fieldset>
        <fieldset data-cli="codex" disabled="${claude}">
            <label class="f" for="sandbox">Sandbox</label><div class="help">Codex has no tool list; its sandbox decides what it may touch.</div>
            <select id="sandbox" name="sandbox">
@for(sandbox in ants.Agent.SANDBOXES)
                <option value="${sandbox}" selected="${sandbox == form.sandbox}">${sandbox}${when (sandbox) { "read-only" -> ": reads files, changes nothing"; "workspace-write" -> ": changes files in the Run workspace"; else -> ": anything, anywhere" }}</option>
@endfor
            </select>
        </fieldset>
    </div>
    <div class="card"><h3><label for="instructions">Standing instructions</label></h3><div class="help">Who the Agent is and how it works, whatever the Skills. Markdown; <b>Expand</b> gives you a big editor with a live preview.</div>
        <textarea id="instructions" name="instructions" rows="14" placeholder="e.g. You implement one Ticket at a time, test first, and commit once the suite passes." data-markdown data-tall>${form.instructions}</textarea></div>
    </fieldset>
</form>
<form id="new-script" method="post" action="/scripts/new/draft"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"></form>
<form id="models-check" method="post" action="/models/check"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"></form>
<script src="/agent.js" defer></script>
@if(draft != null)<script type="module" src="/draft.js"></script>@endif
</main>
</body>
</html>
