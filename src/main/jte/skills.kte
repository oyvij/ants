@param skills: List<ants.SkillRow>
@param message: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Skills · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Skills</h1>
    <div class="acts">
        <form method="post" action="/skills/import" enctype="multipart/form-data"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label class="btn" title="Add one SKILL.md as a Skill">Import…<input type="file" name="file" accept=".md" required hidden onchange="this.form.submit()"></label><label class="btn" title="Add a Skill's folder: its SKILL.md and the files beside it">Import folder…<input type="file" name="file" webkitdirectory required hidden onchange="this.form.submit()"></label></form>
        <a class="btn primary" href="/skills/new">New Skill</a>
    </div>
    <div class="sub">From the folders in <a href="/settings">Settings</a>. Ants writes only into <code>~/.ants/skills</code>; the rest are read-only, with Copy.</div></div>
@if(message != null)<p role="alert">${message}</p>@endif
<table class="library">
    <thead><tr><th>Name</th><th>Run by</th><th>Description</th><th>Folder</th></tr></thead>
    <tbody>
@for(row in skills)
@if(row.hidden)
    <tr class="hidden"><td><b>${row.skill.name}</b></td><td></td><td class="small">${row.skill.description}</td><td class="muted small">${row.where}, hidden by the shipped Skill</td></tr>
@else
    <tr class="click" data-href="/skills/${row.skill.name}"><td><b><a href="/skills/${row.skill.name}">${row.skill.name}</a></b></td><td class="small">@for(agent in row.runBy)<a href="/agents/${agent}">${agent}</a>@if(agent != row.runBy.last()) @endif@endfor@if(row.runBy.isEmpty())<span class="muted">no Agent</span>@endif</td><td class="small">${row.skill.description}</td><td class="muted small">${row.where}</td></tr>
@endif
@endfor
    </tbody>
</table>
</main>
</body>
</html>
