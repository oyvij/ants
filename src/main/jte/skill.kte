@param form: ants.SkillForm
@param message: String? = null
@param draft: ants.DraftHead? = null
@param dependents: ants.Dependents?
@param runBy: List<ants.Agent> = emptyList()
@param references: List<ants.SkillReference> = emptyList()
@param mentions: ants.Mentions = ants.Mentions(emptyList(), emptyList())
@param use: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${form.name ?: "New Skill"} · Skills · Ants</title>
</head>
<body>
@if(use == null)
@template.nav(shell = shell)
@endif
<main>
@if(use == null)<div class="crumbs"><a href="/skills">Skills</a> / ${form.name ?: "New"}</div>@endif
<div class="ph"><h1><span class="ent ent-skill"><svg class="i" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>${form.name ?: "New Skill"}</span></h1>
@if(draft != null)
    @template.drafthead(draft = draft)
@endif
    <div class="acts">
@if(form.readOnly)
        <span class="muted small">Read-only (${form.where})</span>
        <form method="post" action="/skills/${form.name}/copy"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Copy</button></form>
@else
@if(draft?.state == ants.DraftState.CHANGED)
        <form method="post" action="/skills/${form.name}/discard" data-leaves-draft><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Discard Draft</button></form>
@endif
@if(form.name != null)
        <form method="post" action="/skills/${form.name}/delete" data-leaves-draft><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Delete</button></form>
@endif
        <button class="primary" form="skill">Publish</button>
@endif
    </div>
@if(dependents != null)    <div class="sub">@template.usedby(dependents = dependents, none = "no Process")</div>@endif
</div>
@if(message != null)<p role="alert">${message}</p>@endif
<div class="grid2 skill-page">
<div class="card">
<form id="skill" method="post" action="/skills/${form.name ?: "new"}" class="skill" data-autosave="${draft?.endpoint}" data-version="${draft?.version?.toString()}" data-leaves-draft>
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(use != null)
    <input type="hidden" name="use" value="${use}">
@endif
    <div class="fld"><label class="f" for="skill-md">SKILL.md</label><div class="help">How to do something, as Claude Code knows a Skill: Markdown, with its frontmatter on top: the <code>name</code> Agents and Tasks call it by, unique across all Skill folders, and the <code>description</code>, when to use it in one line, which the Agent reads to pick it. What a Task must do, its inputs and its Result belong on the Task.</div>
        <textarea id="skill-md" name="skill" rows="20" placeholder="e.g. ---&#10;name: release-notes&#10;description: Writes the release notes for a version.&#10;---&#10;Read the commits since the last tag and sum them up for users." data-markdown readonly="${form.readOnly}" data-tall>${form.skill}</textarea></div>
</form>
</div>
<div>
<div class="card"><h3>Run by</h3><div class="help">Agents whose <b>Skills it runs</b> list this Skill. Edit that list on the Agent.</div>
@for(agent in runBy)
    <div class="row runby"><span class="grow"><a href="/agents/${agent.name}">${agent.name}</a></span><span class="muted small">${agent.cli}</span></div>
@endfor
@if(runBy.isEmpty())
    <div class="warn">No Agent runs this Skill yet, so no Task can use it.</div>
@endif
</div>
<div class="card references"><h3>References</h3><div class="help">The Markdown files beside its SKILL.md, which it can point the Agent to. Copy a path to paste it into SKILL.md.</div>
@for((i, reference) in references.withIndex())
!{val mark = reference.change?.name?.lowercase()}
@if(reference.change == ants.ReferenceChange.DELETED)
    <div class="row ref"><span class="grow gone"><code>${reference.path}</code><span class="pill p-deleted">deleted</span></span></div>
@else
    <div class="row ref"><a class="grow" href="/skills/${form.name}/references/${reference.path}" data-open="reference-${i}"><code>${reference.path}</code>@if(mark != null)<span class="pill p-${mark}">${mark}</span>@endif<span class="pill p-quiet" data-unmentioned hidden="${reference.path !in mentions.unmentioned}">not mentioned in SKILL.md</span></a><button type="button" class="ghost" data-copy="${reference.path}" title="Copy its path">Copy</button>@if(!form.readOnly)<form method="post" action="/skills/${form.name}/delete-reference" data-reference-change><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="path" value="${reference.path}"><button class="ghost" title="Delete ${reference.path}" aria-label="Delete ${reference.path}">✕</button></form>@endif</div>
@endif
@endfor
@for(path in mentions.missing)
    @template.missingmention(path = path)
@endfor
<template id="missing-mention">@template.missingmention(path = "")</template>
@if(references.isEmpty())
    <div class="muted small">No references: no Markdown file is beside its SKILL.md.</div>
@endif
@if(!form.readOnly && form.name != null)
    <div class="row ref-acts"><button type="button" data-open="new-reference">New reference</button><form method="post" action="/skills/${form.name}/import-reference" enctype="multipart/form-data" data-reference-change><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label class="btn" title="Add a Markdown file from your disk as a reference">Import reference…<input type="file" name="file" accept=".md" required hidden onchange="this.form.requestSubmit()"></label></form></div>
@endif
</div>
</div>
</div>
@for((i, reference) in references.withIndex())
@if(reference.change != ants.ReferenceChange.DELETED)
<dialog class="modal reference" id="reference-${i}">
    <form method="dialog" class="mh"><label for="reference-text-${i}">${reference.path}</label><span class="pill p-quiet" title="Skill">${form.name}</span>@if(form.readOnly)<span class="muted small">Read-only</span>@endif<span class="sp"></span><span class="muted small">Esc to close</span><button class="ghost" title="Close" aria-label="Close">✕</button></form>
@if(form.readOnly)
    <div class="mb"><textarea id="reference-text-${i}" rows="20" placeholder="e.g. # Format&#10;One finding per line." data-markdown readonly data-tall>${reference.text}</textarea></div>
@else
    <form method="post" action="/skills/${form.name}/references/${reference.path}" class="mb" data-reference-save>
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        <p role="alert" hidden></p>
        <textarea id="reference-text-${i}" name="text" rows="20" placeholder="e.g. # Format&#10;One finding per line." data-markdown data-tall>${reference.text}</textarea>
        <div class="go"><button class="primary">Save</button></div>
    </form>
@endif
</dialog>
@endif
@endfor
@if(!form.readOnly && form.name != null)
<dialog class="modal new-reference" id="new-reference">
    <form method="dialog" class="mh"><b>New reference</b><span class="pill p-quiet" title="Skill">${form.name}</span><span class="sp"></span><span class="muted small">Esc to close</span><button class="ghost" title="Close" aria-label="Close">✕</button></form>
    <div class="mb">
        <form method="post" action="/skills/${form.name}/new-reference" data-new-reference>
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <p role="alert" hidden></p>
            <div class="fld"><label class="f" for="new-reference-path">Name</label><div class="help">Its path in the Skill's folder, with subfolders if you like; .md is added when it has no extension.</div><input id="new-reference-path" name="path" placeholder="e.g. references/api.md"></div>
            <div class="go"><button class="primary">Create</button></div>
        </form>
    </div>
</dialog>
@endif
@if(references.isNotEmpty() || !form.readOnly)<script src="/references.js" defer></script>@endif
@if(draft != null)<script type="module" src="/draft.js"></script>@endif
</main>
</body>
</html>
