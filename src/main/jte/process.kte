@import ants.FieldType
@import ants.PreRun
@import ants.local
@import ants.stateName
@param process: org.operaton.bpm.engine.repository.ProcessDefinition
@param fields: List<ants.Field>
@param repos: List<String>
@param profiles: List<String>
@param profile: String?
@param profileFrom: String = "the default"
@param source: ants.Profile?
@param reasons: List<String>
@param schedule: ants.Schedule? = null
@param runs: List<org.operaton.bpm.engine.history.HistoricProcessInstance>
@param names: Map<String, String>
@param clock: java.time.Clock
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
!{val key = process.key; val title = process.name ?: key; val scopable = reasons == listOf(PreRun.CONFIGURE_VAULT) && fields.any { it.type == FieldType.REPOS };}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${title} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/processes">Processes</a> / ${title}</div>
<div class="ph"><h1>${title}</h1>
    <div class="acts"><a class="btn" href="/processes/new?from=${key}">Copy</a><a class="btn" href="${if (schedule == null) "/processes/$key/edit" else "#schedule"}">⏰ ${if (schedule == null) "Add a schedule" else "Schedule"}</a><a class="btn" href="/processes/${key}/edit">Edit diagram</a></div>
    <div class="sub">Vault <b>${source?.vault ?: "—"}</b> · Source map <b>${source?.sourceMap ?: "—"}</b> · @if(profile == null)the defaults in <a href="/settings">Settings</a>@else Profile <b>${profile}</b>, ${profileFrom}@endif</div></div>
<div class="card"><section id="pre-run">
@if(reasons.isEmpty())
    <span class="pill p-ready">Ready</span> <span class="muted small">&nbsp;Names, schemas, CLI commands, Source map, paths and the login all check out.</span>
@else
    <span class="pill p-failed">Can't start</span>@if(scopable) <span class="muted small">&nbsp;unless its Repos are picked</span>@endif
    <ul class="reasons">
    @for(reason in reasons)
        <li>@if(reason == PreRun.CONFIGURE_VAULT)<a href="/settings">${reason}</a>@if(scopable), or pick the Run's Repos@endif@else${reason}@endif</li>
    @endfor
    </ul>
@endif
</section></div>
<div class="card" id="start"><form method="post" action="/processes/${key}/runs">
    <h3>Start a Run</h3>
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(error != null)<p role="alert">${error}</p>@endif
@if(fields.isEmpty())<div class="help">This Process takes no input: its job is in the diagram.</div>@endif
    <div class="fld"><label class="f" for="field-name">Name <span class="muted small" style="font-weight: 500">(optional)</span></label><div class="help">Left empty, the Run is named after its Process and start time.</div><input name="${ants.NAME}" id="field-name"></div>
@if(profiles.size > 1)
    <div class="fld"><label class="f" for="field-profile">Profile</label><div class="help">The Vault and Source map the Run uses.</div>
    <select name="${ants.PROFILE}" id="field-profile" onchange="location.search = '?ants.profile=' + encodeURIComponent(this.value)">
    @for(name in profiles)
        <option selected="${name == profile}">${name}</option>
    @endfor
    </select></div>
@endif
@for(field in fields)
    <div class="fld" data-repos="${if (field.type == FieldType.REPOS) "Filter Source map repos, or type a git URL / owner/name" else null}"><label class="f" for="field-${field.name}">${field.label}@if(!field.required) <span class="muted small" style="font-weight: 500">(optional)</span>@endif</label>
    @if(field.type == FieldType.REPOS)
    <div class="help">${field.help?.let { "$it " } ?: ""}Pick Source map repos, type git URLs such as <span class="eg">git@github.com:you/api.git</span>, or <span class="eg">you/new-app</span> for a new private repo Ants creates on your gh login. Filled in, the Run clones exactly these repos, and the scout takes them as given.</div>
    @if(repos.isNotEmpty())
    <div class="row picks">
    @for(repo in repos)
        <label class="row"><input type="checkbox" name="${field.name}" value="${repo}" checked="${repo in field.storedRepos}"> <span class="mono">${repo}</span></label>
    @endfor
    </div>
    @endif
    <input name="${field.name}" id="field-${field.name}" value="${field.storedRepos.filter { it !in repos }.joinToString(" ")}" placeholder="git URLs, or owner/name for a new repo">
    <div class="help" data-none hidden>None picked, so the scout picks the Run's repos from the whole Source map.</div>
    @else
    @if(field.help != null)<div class="help">${field.help}</div>@endif
    @if(field.choices.isNotEmpty())
    <select name="${field.name}" id="field-${field.name}">
    @for((id, name) in field.choices)
        <option value="${id}" selected="${id == field.stored}">${name}</option>
    @endfor
    </select>
    @elseif(field.type == FieldType.MARKDOWN)
    <textarea name="${field.name}" id="field-${field.name}" required="${field.required}" data-markdown data-tall>${field.stored}</textarea>
    @else
    <input name="${field.name}" id="field-${field.name}" value="${field.stored ?: ""}" required="${field.required}">
    @endif
    @endif
    </div>
@endfor
    <div class="go"><button class="primary" disabled="${reasons.isNotEmpty() && !scopable}">Start</button></div>
</form></div>
<div class="card" id="schedule">
@if(schedule == null)
    <h3>⏰ Schedule</h3>
    <div class="row"><span class="muted grow">No schedule. Runs start when someone presses Start.</span><a class="btn" href="/processes/${key}/edit">＋ Add a schedule</a></div>
@else
    <h3>⏰ Schedule <span class="grow"></span>@if(schedule.paused)<span class="pill p-quiet">Paused</span>@else<span class="pill p-ready">On</span>@endif</h3>
    <div class="kv">
        <span class="k">Runs</span><span>${schedule.words}</span>
        <span class="k">Next Run</span><span>@if(schedule.paused)<span class="muted">paused</span>@elseif(reasons.isNotEmpty())<span style="color: var(--bad)">won't start until the check above passes</span>@else${schedule.at} · ${schedule.countdown}@endif</span>
        <span class="k">Cron</span><span><code>${schedule.cron}</code> <a class="small" href="/processes/${key}/edit">Change it on the diagram</a></span>
    </div>
    @if(schedule.skipped != null)<div class="warn">${schedule.skipped}</div>@endif
    @if(schedule.failed != null)
    <div class="failed"><p role="alert">✕ [failed] The scheduled Run didn't start: ${schedule.failed.why}</p>
    <form method="post" action="/processes/${key}/schedule/start"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary">Start now</button></form>
    <form method="post" action="/processes/${key}/schedule/dismiss"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Dismiss</button></form></div>
    @endif
    <div class="subsec row"><span class="help grow">Missed while Ants was off or asleep? It runs once when Ants is back, not once per missed time.</span>
    <form method="post" action="/processes/${key}/schedule/${if (schedule.paused) "resume" else "pause"}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>${if (schedule.paused) "Resume" else "Pause"}</button></form>
    <form method="post" action="/processes/${key}/schedule/remove"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Remove</button></form></div>
@endif
</div>
<h2>Diagram</h2>
<div id="diagram" class="dia" data-src="/processes/${key}/diagram.bpmn"><div class="legend"><span class="pill p-running">Running</span><span class="pill p-waiting">Waiting on you</span><span class="pill p-done">Done</span><span class="pill p-quiet">Queued / paused</span></div></div>
<h2>Runs of this Process</h2>
@if(runs.isEmpty())
<div class="card muted">None.</div>
@else
<table id="process-runs">
    <tr><th>Run</th><th>Process</th><th>Now</th><th>Started</th></tr>
@for(run in runs)
    !{val state = run.stateName; val pill = when (state) { "Running" -> "p-running"; "Completed" -> "p-done"; "Suspended" -> "p-stuck"; else -> "p-failed" };}
    <tr class="click" data-href="/runs/${run.id}"><td><a href="/runs/${run.id}"><b>${names[run.id]}</b></a></td><td class="muted">${title}</td><td><span class="pill ${pill}">${state}</span></td><td class="muted small">${clock.local(run.startTime.toInstant())}</td></tr>
@endfor
</table>
@endif
<script src="/repos.js" defer></script>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script>
    const box = document.getElementById('diagram'), viewer = new BpmnNavigatedViewer({ container: box });
    fetch(box.dataset.src)
        .then(response => response.text())
        .then(xml => viewer.importXML(xml))
        .then(() => (box.canvas = viewer.get('canvas')).zoom('fit-viewport', 'auto'));
</script>
</main>
</body>
</html>
