@import ants.FieldType
@import ants.PreRun
@import ants.local
@import ants.stateName
@param process: org.operaton.bpm.engine.repository.ProcessDefinition
@param fields: List<ants.Field>
@param repos: List<String>
@param profiles: List<String>
@param profile: String?
@param profileFrom: String = "the default"
@param source: ants.Profile?
@param verbosity: ants.Verbosity = ants.Verbosity.NORMAL
@param reasons: List<String>
@param schedules: List<ants.Schedule> = emptyList()
@param runName: String = ""
@param cron: String? = null
@param runs: List<org.operaton.bpm.engine.history.HistoricProcessInstance>
@param names: Map<String, String>
@param clock: java.time.Clock
@param error: String? = null
@param liveRuns: Map<String, String> = emptyMap()
@param deletable: Boolean = false
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
!{val key = process.key; val title = process.name ?: key; val scheduled = schedules.isNotEmpty(); val scopable = reasons == listOf(PreRun.CONFIGURE_VAULT) && fields.any { it.type == FieldType.REPOS };}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${title} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/processes">Processes</a> / ${title}</div>
<div class="ph"><h1>${title}</h1>
    <div class="acts"><a class="btn" href="/processes/new?from=${key}">Copy</a><a class="btn" href="${if (scheduled) "#schedule" else "#start"}">⏰ ${if (scheduled) "Schedule" else "Add a schedule"}</a><a class="btn" href="/processes/${key}/edit">Edit diagram</a>@if(deletable)<form method="post" action="/processes/${key}/delete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Delete</button></form>@endif</div>
    <div class="sub">Vault <b>${source?.vault ?: "—"}</b> · Source map <b>${source?.sourceMap ?: "—"}</b> · @if(profile == null)the defaults in <a href="/settings">Settings</a>@else Profile <b>${profile}</b>, ${profileFrom}@endif</div></div>
@if(liveRuns.isNotEmpty())<p role="alert">Runs of it are live: @for((i, entry) in liveRuns.entries.withIndex())@if(i > 0), @endif<a href="/runs/${entry.key}">${entry.value}</a>@endfor. Cancel them first.</p>@endif
<div class="card"><section id="pre-run">
@if(reasons.isEmpty())
    <span class="pill p-ready">Ready</span> <span class="muted small">&nbsp;Names, schemas, CLI commands, Source map, paths and the login all check out.</span>
@else
    <span class="pill p-failed">Can't start</span>@if(scopable) <span class="muted small">&nbsp;unless its Repos are picked</span>@endif
    <ul class="reasons">
    @for(reason in reasons)
        <li>@if(reason == PreRun.CONFIGURE_VAULT)<a href="/settings">${reason}</a>@if(scopable), or pick the Run's Repos@endif@else${reason}@endif</li>
    @endfor
    </ul>
@endif
</section></div>
<div class="card" id="start"><form method="post" action="/processes/${key}/runs">
    <h3>Start a Run</h3>
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(error != null)<p role="alert">${error}</p>@endif
@if(fields.isEmpty())<div class="help">This Process takes no input: its job is in the diagram.</div>@endif
    <div class="fld"><label class="f" for="field-name">Name <span class="muted small" style="font-weight: 500">(optional)</span></label><div class="help">Left empty, the Run is named after its Process and start time.</div><input name="${ants.NAME}" id="field-name" value="${runName}" placeholder="e.g. Dark mode toggle"></div>
@if(profiles.size > 1)
    <div class="fld"><label class="f" for="field-profile">Profile</label><div class="help">The Vault and Source map the Run uses.</div>
    <select name="${ants.PROFILE}" id="field-profile" onchange="location.search = '?ants.profile=' + encodeURIComponent(this.value)">
    @for(name in profiles)
        <option selected="${name == profile}">${name}</option>
    @endfor
    </select></div>
@endif
    <div class="fld"><label class="f" for="field-verbosity">Verbosity</label><div class="help">How much the Run's Agents write for you to read.</div>
    <select name="${ants.VERBOSITY}" id="field-verbosity">
    @for(level in ants.Verbosity.entries)
        <option value="${level.value}" selected="${level == verbosity}">${level.label}</option>
    @endfor
    </select></div>
@for(field in fields)
    <div class="fld" data-filter-placeholder="${if (field.type == FieldType.REPOS) "Filter Source map repos, or type a git URL / owner/name" else null}"><label class="f" for="field-${field.name}">${field.label}@if(!field.required) <span class="muted small" style="font-weight: 500">(optional)</span>@endif</label>
    @if(field.type == FieldType.REPOS)
    <div class="help">${field.help?.let { "$it " } ?: ""}Pick Source map repos, type git URLs such as <span class="eg">git@github.com:you/api.git</span>, or <span class="eg">you/new-app</span> for a new private repo Ants creates on your gh login. Filled in, the Run clones exactly these repos, and the scout takes them as given.</div>
    @if(repos.isNotEmpty())
    <div class="row picks">
    @for(repo in repos)
        <label class="row"><input type="checkbox" name="${field.name}" value="${repo}" checked="${repo in field.storedRepos}"> <span class="mono">${repo}</span></label>
    @endfor
    </div>
    @endif
    <input name="${field.name}" id="field-${field.name}" value="${field.storedRepos.filter { it !in repos }.joinToString(" ")}" placeholder="git URLs, or owner/name for a new repo">
    <div class="help" data-none hidden>None picked, so the scout picks the Run's repos from the whole Source map.</div>
    @else
    @if(field.help != null)<div class="help">${field.help}</div>@endif
    @if(field.choices.isNotEmpty())
    <select name="${field.name}" id="field-${field.name}">
    @for((id, name) in field.choices)
        <option value="${id}" selected="${id == field.stored}">${name}</option>
    @endfor
    </select>
    @elseif(field.type == FieldType.MARKDOWN)
    <textarea name="${field.name}" id="field-${field.name}" placeholder="${field.example?.let { "e.g. $it" }}" required="${field.required}" data-markdown data-tall>${field.stored}</textarea>
    @else
    <input name="${field.name}" id="field-${field.name}" value="${field.stored ?: ""}" placeholder="${field.example?.let { "e.g. $it" }}" required="${field.required}">
    @endif
    @endif
    </div>
@endfor
    <div class="go row"><button class="primary" disabled="${reasons.isNotEmpty() && !scopable}">Start</button><button type="button" id="schedule-open" disabled="${reasons.isNotEmpty() && !scopable}">⏰ Schedule</button></div>
    <fieldset id="when" hidden="${cron == null}"><legend>When</legend>
    <p class="row"><label>Every <select id="when-every"></select></label><label data-part="at"> at <input type="time" id="when-at" value="08:00"></label><label data-part="on"> on <select id="when-on"></select></label><label data-part="dom"> on day <input type="number" id="when-dom" min="1" max="31" value="1"></label></p>
    <details id="when-advanced" open="${cron != null}"><summary>Advanced</summary><label class="f" for="when-cron">Cron</label><div class="help">Six fields, seconds first, such as <span class="eg">0 0 8 * * MON-FRI</span>.</div><input name="cron" id="when-cron" value="${cron ?: "0 0 * * * *"}"></details>
    <div class="go"><button class="primary" formaction="/processes/${key}/schedule">Save schedule</button></div>
    </fieldset>
</form></div>
<div class="card" id="schedule">
@if(!scheduled)
    <h3>⏰ Schedule</h3>
    <div class="row"><span class="muted grow">No schedule. Runs start when someone presses Start.</span><a class="btn" href="#start">＋ Add a schedule</a></div>
@else
    <h3>⏰ Schedules</h3>
    <table id="schedules">
    <tr><th>Schedule</th><th>Profile</th><th>Verbosity</th><th>Values</th><th>Runs</th><th>Cron</th><th>Next Run</th><th></th></tr>
    @for(each in schedules)
    <tr id="schedule-${each.id}"><td><b>${each.label}</b></td><td class="k">Profile</td><td>${each.profile ?: "—"}</td><td class="k">Verbosity</td><td>${each.verbosity.value}</td><td class="k">Values</td><td class="small">@for((label, value) in each.values)<div><span class="muted">${label}</span> ${value}</div>@endfor</td><td class="k">Runs</td><td>${each.words}</td><td class="k">Cron</td><td><code>${each.cron}</code></td><td class="k">Next Run</td><td>@if(each.paused)<span class="muted">paused</span>@else${each.at} · ${each.countdown}@endif@if(each.skipped != null)<div class="warn">${each.skipped}</div>@endif@if(each.failed != null)<div class="failed"><p role="alert">✕ [failed] The scheduled Run didn't start: ${each.failed.why}</p><form method="post" action="${each.actions}/dismiss"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Dismiss</button></form></div>@endif</td>
    <td class="row"><form method="post" action="${each.actions}/start"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Start now</button></form>
    <form method="post" action="${each.actions}/${if (each.paused) "resume" else "pause"}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>${if (each.paused) "Resume" else "Pause"}</button></form>
    <form method="post" action="${each.actions}/remove"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Remove</button></form></td></tr>
    @endfor
    </table>
    <div class="subsec help">Missed while Ants was off or asleep? It runs once when Ants is back, not once per missed time.</div>
@endif
</div>
<h2>Diagram</h2>
<div id="diagram" class="dia" data-src="/processes/${key}/diagram.bpmn"><div class="legend"><span class="pill p-running">Running</span><span class="pill p-waiting">Waiting on you</span><span class="pill p-done">Done</span><span class="pill p-quiet">Queued / paused</span></div></div>
<h2>Runs of this Process</h2>
@if(runs.isEmpty())
<div class="card muted">None.</div>
@else
<table id="process-runs">
    <tr><th>Run</th><th>Process</th><th>Now</th><th>Started</th></tr>
@for(run in runs)
    !{val state = run.stateName; val pill = when (state) { "Running" -> "p-running"; "Completed" -> "p-done"; "Suspended" -> "p-stuck"; else -> "p-failed" };}
    <tr class="click" data-href="/runs/${run.id}"><td><a href="/runs/${run.id}"><b>${names[run.id]}</b></a></td><td class="muted">${title}</td><td><span class="pill ${pill}">${state}</span></td><td class="muted small">${clock.local(run.startTime.toInstant())}</td></tr>
@endfor
</table>
@endif
<script src="/repos.js" defer></script>
<script type="module" src="/schedule.js"></script>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script>
    const box = document.getElementById('diagram'), viewer = new BpmnNavigatedViewer({ container: box });
    fetch(box.dataset.src)
        .then(response => response.text())
        .then(xml => viewer.importXML(xml))
        .then(() => (box.canvas = viewer.get('canvas')).zoom('fit-viewport', 'auto'));
</script>
</main>
</body>
</html>
