@import ants.FieldType
@import ants.PreRun
@import ants.local
@import ants.stateName
@param process: org.operaton.bpm.engine.repository.ProcessDefinition
@param fields: List<ants.Field>
@param repos: List<String>
@param profiles: List<String>
@param profile: String?
@param profileFrom: String = "the default"
@param source: ants.Profile?
@param verbosity: ants.Verbosity = ants.Verbosity.NORMAL
@param reasons: List<String>
@param schedules: List<ants.Schedule> = emptyList()
@param scheduleEdits: List<ants.ScheduleEdit> = emptyList()
@param runName: String = ""
@param cron: String? = null
@param runs: List<org.operaton.bpm.engine.history.HistoricProcessInstance>
@param names: Map<String, String>
@param clock: java.time.Clock
@param error: String? = null
@param liveRuns: Map<String, String> = emptyMap()
@param deletable: Boolean = false
@param draftState: ants.DraftState = ants.DraftState.PUBLISHED
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
!{val key = process.key; val title = process.name ?: key; val scheduled = schedules.isNotEmpty(); val scopable = reasons == listOf(PreRun.CONFIGURE_VAULT) && fields.any { it.type == FieldType.REPOS };}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${ants.Transcript.plain(title)} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/processes">Processes</a> / $unsafe{ants.Transcript.inline(title)}</div>
<div class="ph"><h1>$unsafe{ants.Transcript.inline(title)}</h1>@template.draftmark(state = draftState, list = true)
    <div class="acts"><form method="post" action="/processes/new"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="from" value="${key}"><button>Copy</button></form><a class="btn" href="${if (scheduled) "#schedule" else "#start"}">⏰ ${if (scheduled) "Schedule" else "Add a schedule"}</a><a class="btn" href="/processes/${key}/edit">Edit diagram</a>@if(deletable)<form method="post" action="/processes/${key}/delete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Delete</button></form>@endif</div>
    <div class="sub">Vault <b>${source?.vault ?: "—"}</b> · Source map <b>${source?.sourceMap ?: "—"}</b> · @if(profile == null)the defaults in <a href="/settings">Settings</a>@else Profile <b>${profile}</b>, ${profileFrom}@endif</div></div>
@if(liveRuns.isNotEmpty())<p role="alert">Runs of it are live: @for((i, entry) in liveRuns.entries.withIndex())@if(i > 0), @endif<a href="/runs/${entry.key}">${entry.value}</a>@endfor. Cancel them first.</p>@endif
<div class="card"><section id="pre-run">
@if(reasons.isEmpty())
    <span class="pill p-ready">Ready</span> <span class="muted small">&nbsp;Names, schemas, CLI commands, Source map, paths and the login all check out.</span>
@else
    <span class="pill p-failed">Can't start</span>@if(scopable) <span class="muted small">&nbsp;unless its Repos are picked</span>@endif
    <ul class="reasons">
    @for(reason in reasons)
        <li>@if(reason == PreRun.CONFIGURE_VAULT)<a href="/settings">$unsafe{ants.Transcript.inline(reason)}</a>@if(scopable), or pick the Run's Repos@endif@else$unsafe{ants.Transcript.inline(reason)}@endif</li>
    @endfor
    </ul>
@endif
</section></div>
<div class="card" id="start"><form method="post" action="/processes/${key}/runs">
    <h3>Start a Run</h3>
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(error != null)<p role="alert">$unsafe{ants.Transcript.inline(error)}</p>@endif
@if(fields.isEmpty())<div class="help">This Process takes no input: its job is in the diagram.</div>@endif
@template.startfields(fields = fields, repos = repos, profiles = profiles, profile = profile, verbosity = verbosity, runName = runName, reload = "?ants.profile=")
    <div class="go row"><button class="primary" disabled="${reasons.isNotEmpty() && !scopable}" data-pending="Starting…">Start</button><button type="button" id="schedule-open" disabled="${reasons.isNotEmpty() && !scopable}">⏰ Schedule</button></div>
@template.when(cron = cron, action = "/processes/${key}/schedule", hidden = cron == null)
</form></div>
<div class="card" id="schedule">
@if(!scheduled)
    <h3>⏰ Schedule</h3>
    <div class="row"><span class="muted grow">No schedule. Runs start when someone presses Start.</span><a class="btn" href="#start">＋ Add a schedule</a></div>
@else
    <h3>⏰ Schedules</h3>
    <table id="schedules">
    <tr><th>Schedule</th><th>Profile</th><th>Verbosity</th><th>Values</th><th>Runs</th><th>Cron</th><th>Next Run</th><th></th></tr>
    @for(edit in scheduleEdits)
    !{val each = edit.schedule; val open = edit.open;}
    <tr id="schedule-${each.id}"><td><b>$unsafe{ants.Transcript.inline(each.label)}</b></td><td class="k">Profile</td><td>${each.profile ?: "—"}</td><td class="k">Verbosity</td><td>${each.verbosity.value}</td><td class="k">Values</td><td class="small">@for((label, value) in each.values)<div><span class="muted">$unsafe{ants.Transcript.inline(label)}</span> ${value}</div>@endfor</td><td class="k">Runs</td><td>$unsafe{ants.Transcript.inline(each.words)}</td><td class="k">Cron</td><td><code>${each.cron}</code></td><td class="k">Next Run</td><td>@if(each.paused)<span class="muted">paused</span>@else${each.at} · ${each.countdown}@endif@if(each.skipped != null)<div class="warn">${each.skipped}</div>@endif@if(each.failed != null)<div class="failed"><p role="alert">✕ [failed] The scheduled Run didn't start: $unsafe{ants.Transcript.inline(each.failed.why)}</p><form method="post" action="${each.actions}/dismiss"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Dismiss</button></form></div>@endif</td>
    <td class="row"><button type="button" data-edit aria-expanded="${open.toString()}" aria-controls="edit-${each.id}">Edit</button><form method="post" action="${each.actions}/start"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button data-pending="Starting…">Start now</button></form>
    <form method="post" action="${each.actions}/${if (each.paused) "resume" else "pause"}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>${if (each.paused) "Resume" else "Pause"}</button></form>
    <form method="post" action="${each.actions}/remove"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Remove</button></form></td></tr>
    <tr class="edit" id="edit-${each.id}" hidden="${!open}"><td colspan="8"><form method="post" action="${each.actions}">
        <h3>Edit $unsafe{ants.Transcript.inline(each.label)}</h3>
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    @for(reason in edit.reasons)<p role="alert">$unsafe{ants.Transcript.inline(reason)}</p>@endfor
@template.startfields(fields = edit.fields, repos = edit.repos, profiles = profiles, profile = edit.profile, verbosity = edit.verbosity, runName = edit.runName, prefix = edit.prefix, reload = "?edit=${each.id}&edit.profile=", anchor = "#edit-${each.id}")
@template.when(cron = edit.cron, action = each.actions, prefix = edit.prefix, advanced = edit.reasons.isNotEmpty())
    </form></td></tr>
    @endfor
    </table>
    <div class="subsec help">Missed while Ants was off or asleep? It runs once when Ants is back, not once per missed time.</div>
@endif
</div>
<h2>Diagram</h2>
<div id="diagram" class="dia" data-src="/processes/${key}/diagram.bpmn"><div class="legend"><span class="pill p-running">Running</span><span class="pill p-waiting">Waiting on you</span><span class="pill p-done">Done</span><span class="pill p-quiet">Queued / paused</span></div></div>
<h2>Runs of this Process</h2>
@if(runs.isEmpty())
<div class="card muted">None.</div>
@else
<table id="process-runs">
    <tr><th>Run</th><th>Process</th><th>Now</th><th>Started</th></tr>
@for(run in runs)
    !{val state = run.stateName; val pill = when (state) { "Running" -> "p-running"; "Completed" -> "p-done"; "Suspended" -> "p-stuck"; else -> "p-failed" };}
    <tr class="click" data-href="/runs/${run.id}"><td><a href="/runs/${run.id}"><b>$unsafe{ants.Transcript.inline(names[run.id])}</b></a></td><td class="muted">$unsafe{ants.Transcript.inline(title)}</td><td><span class="pill ${pill}">${state}</span></td><td class="muted small">${clock.local(run.startTime.toInstant())}</td></tr>
@endfor
</table>
@endif
<script src="/repos.js" defer></script>
<script type="module" src="/schedule.js"></script>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script>
    const box = document.getElementById('diagram'), viewer = new BpmnNavigatedViewer({ container: box });
    fetch(box.dataset.src)
        .then(response => response.text())
        .then(xml => viewer.importXML(xml))
        .then(() => (box.canvas = viewer.get('canvas')).zoom('fit-viewport', 'auto'));
</script>
</main>
</body>
</html>
