@import ants.FieldType
@param process: org.operaton.bpm.engine.repository.ProcessDefinition
@param fields: List<ants.Field>
@param repos: List<String>
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="${colorScheme}">
    <title>${process.name ?: process.key} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav()
<p><a href="/processes">Processes</a></p>
<h1>${process.name ?: process.key}</h1>
<p><a href="/processes/${process.key}/edit">Edit</a> · <a href="/processes/new?from=${process.key}">Copy</a></p>
<div id="diagram" data-src="/processes/${process.key}/diagram.bpmn" style="height: 60vh"></div>
<form method="post" action="/processes/${process.key}/runs">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(error != null)<p role="alert">${error}</p>@endif
@for(field in fields)
    <p><label>${field.label}<br>
    @if(field.type == FieldType.MARKDOWN)
        <textarea name="${field.name}" required="${field.required}">${field.stored}</textarea>
    @elseif(field.type == FieldType.REPOS)
        <select name="${field.name}" multiple required="${field.required}">
        @for(repo in repos)
            <option selected="${repo in field.storedRepos}">${repo}</option>
        @endfor
        </select>
    @else
        <input name="${field.name}" value="${field.stored ?: ""}" required="${field.required}">
    @endif
    </label>@if(field.help != null)<br><small>${field.help}</small>@endif</p>
@endfor
    <button>Start</button>
</form>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script>
    const viewer = new BpmnNavigatedViewer({ container: '#diagram' });
    fetch(document.getElementById('diagram').dataset.src)
        .then(response => response.text())
        .then(xml => viewer.importXML(xml))
        .then(() => viewer.get('canvas').zoom('fit-viewport'));
</script>
</body>
</html>
