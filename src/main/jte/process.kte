@import ants.FieldType
@import ants.PreRun
@param process: org.operaton.bpm.engine.repository.ProcessDefinition
@param fields: List<ants.Field>
@param repos: List<String>
@param reasons: List<String>
@param schedule: ants.Schedule? = null
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${process.name ?: process.key} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/processes">Processes</a> / ${process.name ?: process.key}</div>
<div class="ph"><h1>${process.name ?: process.key}</h1><div class="acts"><a class="btn" href="/processes/new?from=${process.key}">Copy</a><a class="btn" href="/processes/${process.key}/edit">Edit diagram</a></div></div>
@if(schedule != null)
<section id="schedule">
    <h2>Schedule</h2>
    <p>${schedule.words}@if(schedule.paused) · paused@elseif(schedule.at != null) · next ${schedule.at}@endif</p>
    @if(schedule.skipped != null)<p>${schedule.skipped}</p>@endif
    @if(schedule.failed != null)
    <p role="alert">✕ [failed] The scheduled Run didn't start: ${schedule.failed.why}</p>
    <form method="post" action="/processes/${process.key}/schedule/start"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary">Start now</button></form>
    <form method="post" action="/processes/${process.key}/schedule/dismiss"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Dismiss</button></form>
    @endif
    <form method="post" action="/processes/${process.key}/schedule/${if (schedule.paused) "resume" else "pause"}"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>${if (schedule.paused) "Resume" else "Pause"}</button></form>
    <form method="post" action="/processes/${process.key}/schedule/remove"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Remove</button></form>
</section>
@endif
<div id="diagram" class="dia" data-src="/processes/${process.key}/diagram.bpmn"></div>
<form method="post" action="/processes/${process.key}/runs">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
@if(error != null)<p role="alert">${error}</p>@endif
    <p><label>Name<br><input name="${ants.NAME}"></label><br><small>Optional. Left empty, the Run is named after its Process and start time.</small></p>
@for(field in fields)
    @if(field.type == FieldType.REPOS)
    <label class="f" for="field-${field.name}">${field.label}</label>
    @if(repos.isNotEmpty())
    <select name="${field.name}" multiple>
    @for(repo in repos)
        <option selected="${repo in field.storedRepos}">${repo}</option>
    @endfor
    </select>
    @endif
    <input name="${field.name}" id="field-${field.name}" value="${field.storedRepos.filter { it !in repos }.joinToString(" ")}" placeholder="git URLs, or owner/name for a new repo">
    <div class="help">@if(field.help != null)${field.help} @endif Pick Source map repos, type git URLs such as <span class="eg">git@github.com:you/api.git</span>, or <span class="eg">you/new-app</span> for a new private repo Ants creates on your gh login. Filled in, the Run is scoped to exactly these repos: no scout, no Vault and no Source map.</div>
    @else
    <p><label>${field.label}<br>
    @if(field.type == FieldType.MARKDOWN)
        <textarea name="${field.name}" required="${field.required}">${field.stored}</textarea>
    @else
        <input name="${field.name}" value="${field.stored ?: ""}" required="${field.required}">
    @endif
    </label>@if(field.help != null)<br><small>${field.help}</small>@endif</p>
    @endif
@endfor
!{val scopable = reasons == listOf(PreRun.CONFIGURE_VAULT) && fields.any { it.type == FieldType.REPOS };}
<section id="pre-run">
@if(reasons.isEmpty())
    <p><strong>Ready</strong></p>
@else
    <p><strong>Can't start</strong>@if(scopable) unless scoped to its Repos@endif</p>
    <ul>
    @for(reason in reasons)
        <li>@if(reason == PreRun.CONFIGURE_VAULT)<a href="/settings">${reason}</a>@if(scopable), or name the Run's Repos@endif@else${reason}@endif</li>
    @endfor
    </ul>
@endif
</section>
    <button class="primary" disabled="${reasons.isNotEmpty() && !scopable}">Start</button>
</form>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script>
    const box = document.getElementById('diagram'), viewer = new BpmnNavigatedViewer({ container: box });
    fetch(box.dataset.src)
        .then(response => response.text())
        .then(xml => viewer.importXML(xml))
        .then(() => (box.canvas = viewer.get('canvas')).zoom('fit-viewport'));
</script>
</main>
</body>
</html>
