@param entry: ants.TaskEntry
@param shown: String
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${entry.icon} ${entry.tag} ${entry.task} · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/notifications">Notification list</a> / <a href="/runs/${entry.run}">${entry.runName}</a> / ${entry.task}</div>
<div class="ph"><h1>${entry.summary.ifEmpty { entry.task }}</h1><div class="acts"><span data-tag="${entry.tag}">${entry.icon} ${entry.tag}</span><span class="muted small">${entry.process} · waiting ${entry.waited}</span></div></div>
<article>$unsafe{shown}</article>
@if(error != null)<p role="alert">${error}</p>@endif
<form method="post">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <label>Comment <textarea name="comment"></textarea></label>
    <button class="primary" name="action" value="approve">Approve</button>
    <button name="action" value="send-back">Send back</button>
</form>
</main>
</body>
</html>
