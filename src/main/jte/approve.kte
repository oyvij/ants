@param entry: ants.TaskEntry
@param shown: String
@param file: String? = null
@param view: ants.TaskView
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${entry.icon} ${entry.tag} ${entry.task} · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
@template.taskhead(view = view, run = entry.run, runName = entry.runName, tokens = "")
<div class="card md">@if(file != null)<div class="muted small mono">${file}</div>@endif$unsafe{shown}</div>
@if(error != null)<p role="alert">${error}</p>@endif
<form method="post">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <div class="fld"><label class="f" for="comment">Comment</label>
        <div class="help">Required to send back. The Agent's session resumes with it.</div>
        <textarea id="comment" name="comment" placeholder="e.g. Ship it, but rename the flag first." data-markdown></textarea></div>
    <div class="composer"><div>
        <span class="grow"></span>
        <button name="action" value="send-back">Send back</button>
        <button class="primary" name="action" value="approve">Approve</button>
    </div></div>
</form>
</main>
</body>
</html>
