@param file: ants.Tracked
@param runName: String
@param article: String
@param tickets: List<ants.Tracked>
@param error: String? = null
@param sent: ants.AgentLauncher.Fixing? = null
@param waitsFor: List<String> = emptyList()
@param sendBack: Boolean = false
@param comment: String = ""
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${file.title} · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><div class="crumbs"><a href="/tickets">Tickets</a> / <a href="/runs/${file.run}">${runName}</a>@if(file.name != "spec") / <a href="/runs/${file.run}/tickets/spec">Spec</a>@endif</div>
    <div class="acts"><a class="btn" href="${file.href}/edit">Edit</a></div></div>
@if(error != null)<p role="alert">${error}</p>@endif
$unsafe{article}
@if(file.forHuman && waitsFor.isNotEmpty())
<p role="status">Waits for ${waitsFor.joinToString()}, then it is yours to do.</p>
@elseif(file.forHuman)
<form method="post" action="${file.href}/send-back">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    @if(sent != null)<p role="status">${sent.summary}</p>@endif
    @if(sendBack)<p><label for="comment">What fails, for the Agents that built what it checks</label><br><textarea id="comment" name="comment" rows="6" placeholder="e.g. The export still lists cancelled invoices.">${comment}</textarea></p>@endif
    <p>This Ticket is yours to do. <button class="primary" formaction="${file.href}/done">Mark done</button>@if(sendBack) <button>Send back</button>@endif</p>
</form>
@endif
@if(tickets.isNotEmpty())
<h2>Tickets</h2>
<ul>
@for(ticket in tickets)
    <li><a href="${ticket.href}">${ticket.title}</a> · ${ticket.status ?: ""}</li>
@endfor
</ul>
@endif
<form id="tick" method="post" action="${file.href}/tick" hidden>
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <input type="hidden" name="line">
    <input type="hidden" name="version">
</form>
<script type="module">
    // Ticking a checkbox saves it, saying which version of the file the page showed; the page follows the file as it changes.
    const tick = document.getElementById('tick');
    document.addEventListener('change', event => {
        if (!event.target.matches('#ticket input[type=checkbox]')) return;
        tick.line.value = event.target.dataset.line;
        tick.version.value = document.getElementById('ticket').dataset.version;
        tick.requestSubmit();
    });
    stream.on('ticket', html => {
        const template = document.createElement('template');
        template.innerHTML = html;
        document.getElementById('ticket').replaceWith(template.content.firstElementChild);
    });
    stream.follow('ticket=' + encodeURIComponent('${file.run}/${file.name}'));
</script>
</main>
</body>
</html>
