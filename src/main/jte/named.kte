@param list: String
@param default: String
@param named: ants.Named
<div class="listed">
@for(i in named.shown.indices)
    <div class="row" hidden="${i == named.rows.size}">
        <input class="name" name="${list}[${i}].name" value="${named.shown[i].first}" aria-label="Name">
        <input class="grow mono" name="${list}[${i}].path" value="${named.shown[i].second}" aria-label="Path">
        <label class="row small"><input type="radio" name="${default}" value="${i}" checked="${i == named.default}"> default</label>
        <button type="button" class="ghost" data-remove>Remove</button>
    </div>
@endfor
    <button type="button" data-add>＋ Add</button>
</div>
