@param list: String
@param default: String
@param named: ants.Named
@param setUp: Map<String?, String>? = null
@param edit: List<String>? = null
@param nameExample: String
@param pathExample: String
<div class="listed">
@for(i in named.shown.indices)
    <div class="row" hidden="${i == named.rows.size}">
        <label class="cap name">Name<input name="${list}[${i}].name" value="${named.shown[i].first}" placeholder="e.g. ${nameExample}"></label>
        <label class="cap grow">Path<input class="mono" name="${list}[${i}].path" value="${named.shown[i].second}" placeholder="e.g. ${pathExample}"></label>
        <label class="row small"><input type="radio" name="${default}" value="${i}" checked="${i == named.default}"> default</label>
@if(setUp != null)
        !{val profile = setUp[named.shown[i].first]}
        @if(profile != null)<button formaction="/processes/set_up_vault/runs" name="ants.profile" value="${profile}" title="Runs Set up Vault on this Vault${if (profile.isEmpty()) "" else ", with the Profile $profile"}">Set up Vault</button>
        @else<button type="button" disabled title="Pair it with a Source map in a Profile below, and save">Set up Vault</button>@endif
@endif
@if(edit != null && named.shown[i].first in edit)
        <button type="button" data-edit="source-map-${edit.indexOf(named.shown[i].first)}">Edit</button>
@endif
        <button type="button" class="ghost" data-remove>Remove</button>
    </div>
@endfor
    <button type="button" data-add>＋ Add</button>
</div>
