@param scripts: List<ants.Script>
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Scripts · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Scripts</h1>
    <div class="acts"><a class="btn primary" href="/scripts/new">New Script</a></div>
    <div class="sub">JavaScript you write once, run with Node's built-ins, its inputs on stdin and its vars and Secrets in <code>process.env</code>. Kept in <code>~/.ants/scripts</code>.</div></div>
<table class="library">
    <thead><tr><th>Name</th><th>Description</th></tr></thead>
    <tbody>
@for(script in scripts)
    <tr class="click" data-href="/scripts/${script.name}"><td><b><a href="/scripts/${script.name}">${script.name}</a></b></td><td class="small">${script.description}</td></tr>
@endfor
@if(scripts.isEmpty())
    <tr><td colspan="2" class="muted small">No Script yet.</td></tr>
@endif
    </tbody>
</table>
</main>
</body>
</html>
