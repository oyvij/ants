@import ants.stateName
@import ants.tokens
@param run: org.operaton.bpm.engine.history.HistoricProcessInstance
@param name: String
@param variables: Map<String, String>
@param agentTasks: Map<String, String>
@param kept: String?
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param transcripts: Map<String, Long>
@param report: Boolean
@param workspace: String?
@param repos: List<String>
@param scope: List<String>?
@param profile: String? = null
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${name} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/runs">Runs</a> / ${name}</div>
<div class="ph"><h1>${name}</h1>
@if(run.endTime == null)
    <div class="acts"><form method="post" action="/runs/${run.id}/cancel">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        <button class="danger" onclick="return confirm('Cancel this Run? Its running Agents stop, and its Run workspace is kept until you dismiss it.')">Cancel the Run</button>
    </form></div>
@endif
    <div class="sub" id="state">State: ${run.stateName}</div></div>
<p><a href="/processes/${run.processDefinitionKey}">${run.processDefinitionName ?: run.processDefinitionKey}</a> · <small>${run.id}</small></p>
@if(scope != null)
<p id="scope">Scoped to its repos: @for((i, repo) in scope.withIndex())@if(i > 0), @endif<code>${repo}</code>@endfor. No scout, no Vault and no Source map.</p>
@endif
@if(profile != null)
<p id="profile">Profile: ${profile}</p>
@endif
@if(run.endTime == null || variables.containsKey(ants.NAME))
<form method="post" action="/runs/${run.id}/name">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <p><label>Name <input name="name" value="${name}" required></label> <button>Rename</button></p>
</form>
@endif
@if(workspace != null)
<section id="where">
    <p>Run workspace <code>${workspace}</code></p>
@if(repos.isNotEmpty())
    <ul>
@for(repo in repos)
        <li><code>${repo}</code></li>
@endfor
    </ul>
@endif
</section>
@endif
@if(report)
<p><a href="/runs/${run.id}/report">Report</a></p>
@endif
@if(kept != null)
<form method="post" action="/runs/${run.id}/dismiss">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <p>The Run workspace is kept at <code>${kept}</code> until you dismiss it. <button>Dismiss</button></p>
</form>
@endif
<nav id="trail" hidden></nav>
<div id="diagram" class="dia"><div class="legend"><span class="pill p-running">Running</span><span class="pill p-waiting">Waiting on you</span><span class="pill p-done">Done</span><span class="pill p-quiet">Queued / paused</span></div></div>
<aside id="drawer" hidden><button id="close" aria-label="Close">✕</button><div id="parts"></div></aside>
@if(agentTasks.isNotEmpty())
<h2>Agent Tasks</h2>
<dl>
@for((task, state) in agentTasks)
    <dt>${task}</dt><dd>${state}</dd>
@endfor
</dl>
@endif
@if(transcripts.isNotEmpty())
<h2>Transcripts · ${tokens(transcripts.values.sum())}</h2>
<ul>
@for((task, count) in transcripts)
    <li><a href="/runs/${run.id}/tasks/${task}/transcript">${task}</a> · ${tokens(count)}</li>
@endfor
</ul>
@endif
<h2>Variables</h2>
<dl>
@for((name, value) in variables)
    <dt>${name}</dt><dd><code>${value}</code></dd>
@endfor
</dl>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script type="module">
    // The live diagram: each update patches only the elements whose state, badge or Round changed, so an open drawer stays.
    // Clicking a call activity shows the called Process's live diagram in its place; the trail above it leads back.
    // The page's stream follows the instance shown, and the Task whose drawer is open.
    const run = '${run.id}';
    const viewer = new BpmnNavigatedViewer({ container: '#diagram' });
    const canvas = document.getElementById('diagram').canvas = viewer.get('canvas'), overlays = viewer.get('overlays'), registry = viewer.get('elementRegistry');
    const trail = [{ id: run, name: document.querySelector('h1').textContent }], nav = document.getElementById('trail');
    let current = run, drawn = null, latest = null, shown = {}, called = {}, task = null;
    const follow = () => stream.follow('run=' + current + (task === null ? '' : '&drawer=' + encodeURIComponent(task)));
    // Paints the latest update once the diagram it is for is drawn.
    function paint() {
        if (!latest || drawn !== current) return;
        called = latest.called;
        if (current === run) document.getElementById('state').textContent = 'State: ' + latest.state;
        for (const [id, now] of Object.entries(latest.elements)) {
            const before = shown[id];
            if (!registry.get(id) || JSON.stringify(before) === JSON.stringify(now)) continue;
            if (before) canvas.removeMarker(id, 'ants-' + before.state);
            canvas.addMarker(id, 'ants-' + now.state);
            overlays.remove({ element: id, type: 'ants' });
            const badge = [now.badge, now.round > 1 ? '↻ ' + now.round : null].filter(Boolean).join(' · ');
            if (badge) {
                const span = document.createElement('span');
                span.className = 'ants-badge';
                span.textContent = badge;
                overlays.add(id, 'ants', { position: { bottom: 8, right: 8 }, html: span });
            }
            shown[id] = now;
        }
    }
    stream.on('run', data => { latest = JSON.parse(data); paint(); });
    function show(instance) {
        drawer.hidden = true;
        task = null;
        current = instance;
        drawn = null;
        latest = null;
        shown = {};
        called = {};
        nav.hidden = trail.length < 2;
        nav.replaceChildren(...trail.flatMap((step, i) => {
            const link = i === trail.length - 1 ? document.createElement('strong') : Object.assign(document.createElement('a'), {
                href: '#', onclick: event => { event.preventDefault(); trail.length = i + 1; show(step.id); },
            });
            link.textContent = step.name;
            return i ? [' › ', link] : [link];
        }));
        follow();
        fetch('/runs/' + instance + '/diagram.bpmn').then(response => response.text()).then(xml => viewer.importXML(xml)).then(() => {
            if (current !== instance) return;
            canvas.zoom('fit-viewport');
            drawn = instance;
            paint();
        });
    }
    viewer.on('element.click', ({ element }) => {
        if (element.type === 'bpmn:CallActivity' && called[element.id]) {
            trail.push({ id: called[element.id], name: element.businessObject.name || element.id });
            show(called[element.id]);
        } else if (element.type.endsWith('Task')) open(element.id);
    });

    // The Task drawer follows its Task, replacing only the parts that changed, so a comment being typed stays, and
    // removing the parts that are gone, such as Send once the session ends or the action once it is handled.
    const drawer = document.getElementById('drawer'), parts = document.getElementById('parts');
    let received = {};
    function open(id) {
        task = id;
        received = {};
        parts.replaceChildren();
        drawer.hidden = false;
        follow();
    }
    stream.on('drawer', html => {
        const template = document.createElement('template');
        template.innerHTML = html;
        const now = [...template.content.children];
        for (const old of [...parts.children]) {
            if (now.some(part => part.id === old.id)) continue;
            old.remove();
            delete received[old.id];
        }
        now.forEach((part, i) => {
            if (received[part.id] === part.outerHTML) return;
            received[part.id] = part.outerHTML;
            const old = document.getElementById(part.id);
            old ? old.replaceWith(part) : parts.insertBefore(part, parts.children[i] ?? null);
        });
    });
    document.getElementById('close').onclick = () => { task = null; drawer.hidden = true; follow(); };
    show(run);
</script>
</main>
</body>
</html>
