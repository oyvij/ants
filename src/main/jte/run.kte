@import ants.stateName
@import ants.tokens
@import ants.RUN_PILLS
@param run: org.operaton.bpm.engine.history.HistoricProcessInstance
@param name: String
@param variables: Map<String, String>
@param agentTasks: Map<String, String>
@param kept: String?
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param transcripts: Map<String, Long>
@param report: String?
@param tasks: List<ants.TaskView>
@param started: String
@param branch: String?
@param cloned: List<String>
@param vault: String?
@param workspace: String?
@param repos: List<String>
@param scope: List<String>?
@param profile: String? = null
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${name} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/runs">Runs</a> / ${name}</div>
<div class="ph"><h1><span id="name">${name}</span> <span class="pill p-${RUN_PILLS[run.stateName] ?: "quiet"}" id="state">${run.stateName}</span></h1>
    <div class="acts">
@if(run.endTime == null || variables.containsKey(ants.NAME))
        <button type="button" popovertarget="rename">Rename</button>
        <form method="post" action="/runs/${run.id}/name" id="rename" class="card" popover>
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <label class="f" for="new-name">Name</label>
            <div class="row"><input id="new-name" name="name" value="${name}" required><button class="primary">Rename</button></div>
        </form>
@endif
@if(run.endTime == null)
        <form method="post" action="/runs/${run.id}/cancel">
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <button class="danger" onclick="return confirm('Cancel the Run? Its running Agents stop, and its Run workspace is kept until you dismiss it.')">Cancel the Run</button>
        </form>
@elseif(kept != null)
        <form method="post" action="/runs/${run.id}/dismiss">
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <button>Dismiss</button>
        </form>
@endif
    </div>
    <div class="sub"><a href="/processes/${run.processDefinitionKey}">${run.processDefinitionName ?: run.processDefinitionKey}</a> · started ${started}@if(branch != null) · branch <code>${branch}</code>@endif
        · repos @if(cloned.isEmpty())none yet@else@for(repo in cloned)<code>${repo}</code> @endfor@endif
@if(scope != null)        · <span id="scope">Repos picked: @for((i, repo) in scope.withIndex())@if(i > 0), @endif<code>${repo}</code>@endfor</span>@endif
@if(profile != null)        · <span id="profile">Profile ${profile}</span>@endif
@if(vault != null)        · Vault ${vault}@endif
        · <small>${run.id}</small></div>
</div>
<nav id="trail" hidden></nav>
<div id="diagram" class="dia"><div class="legend"><span class="pill p-running">Running</span><span class="pill p-waiting">Waiting on you</span><span class="pill p-done">Done</span><span class="pill p-quiet">Queued / paused</span></div></div>
<div class="help">Drag to pan, Ctrl/⌘ + scroll to zoom. Click a Task to open it.</div>
<aside id="drawer" class="drawer" hidden><button id="close" class="ghost" title="Close (Esc)" aria-label="Close">✕</button><div id="parts"></div></aside>
<div id="run-tasks">@template.tasks(tasks = tasks)</div>
@if(kept != null)
<h2>Run workspace</h2>
<div class="card">Kept at <code>${kept}</code> until you dismiss the Run.</div>
@endif
@if(report != null)
<h2><a href="/runs/${run.id}/report">Report</a></h2>
<div class="card md">$unsafe{report}</div>
@else
<div class="help">The Report appears here when the Run ends.</div>
@endif
<details id="details">
<summary class="small">Details: the Run workspace, each Agent Task, the Transcripts and the variables</summary>
@if(workspace != null)
<section id="where">
    <p>Run workspace <code>${workspace}</code></p>
@if(repos.isNotEmpty())
    <ul>
@for(repo in repos)
        <li><code>${repo}</code></li>
@endfor
    </ul>
@endif
</section>
@endif
@if(agentTasks.isNotEmpty())
<h2>Agent Tasks</h2>
<dl>
@for((task, state) in agentTasks)
    <dt>${task}</dt><dd>${state}</dd>
@endfor
</dl>
@endif
@if(transcripts.isNotEmpty())
<h2>Transcripts · ${tokens(transcripts.values.sum())}</h2>
<ul>
@for((task, count) in transcripts)
    <li><a href="/runs/${run.id}/tasks/${task}/transcript">${task}</a> · ${tokens(count)}</li>
@endfor
</ul>
@endif
<h2>Variables</h2>
<dl>
@for((name, value) in variables)
    <dt>${name}</dt><dd><code>${value}</code></dd>
@endfor
</dl>
</details>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script type="module">
    // The live diagram: each update patches only the elements whose state, badge or Round changed, so an open drawer stays.
    // Clicking a call activity shows the called Process's live diagram in its place; the trail above it leads back.
    // The page's stream follows the instance shown, and the Task whose drawer is open.
    const run = '${run.id}';
    const viewer = new BpmnNavigatedViewer({ container: '#diagram' });
    const canvas = document.getElementById('diagram').canvas = viewer.get('canvas'), overlays = viewer.get('overlays'), registry = viewer.get('elementRegistry');
    const trail = [{ id: run, name: document.getElementById('name').textContent }], nav = document.getElementById('trail');
    let current = run, drawn = null, latest = null, shown = {}, called = {}, task = null;
    const follow = () => stream.follow('run=' + current + '&tasks=' + run + (task === null ? '' : '&drawer=' + encodeURIComponent(task)));
    stream.on('tasks', html => stream.patch(document.getElementById('run-tasks'), html));
    // Paints the latest update once the diagram it is for is drawn.
    function paint() {
        if (!latest || drawn !== current) return;
        called = latest.called;
        if (current === run) Object.assign(document.getElementById('state'), {
            textContent: latest.state, className: 'pill p-' + latest.pill,
        });
        for (const [id, now] of Object.entries(latest.elements)) {
            const before = shown[id];
            if (!registry.get(id) || JSON.stringify(before) === JSON.stringify(now)) continue;
            if (before) canvas.removeMarker(id, 'ants-' + before.state);
            canvas.addMarker(id, 'ants-' + now.state);
            overlays.remove({ element: id, type: 'ants' });
            // A Task's badge on its top edge: ✓ once done, else its state or what it waits for; its Round at its foot.
            if (/Task$|CallActivity/.test(registry.get(id).type)) {
                const badge = (css, text, position) => {
                    const span = Object.assign(document.createElement('span'), { className: 'ov ' + css, textContent: text });
                    if (css === 'running') span.prepend(document.createElement('i'));
                    overlays.add(id, 'ants', { position, html: span });
                };
                if (now.state === 'done') badge('done', '✓', { top: -12, right: 16 });
                else badge(now.state === 'queued' || now.state === 'cancelled' ? 'quiet' : now.state, now.badge ?? 'Running', { top: -12, right: 70 });
                if (now.round > 1) badge('quiet', 'round ' + now.round, { bottom: 14, left: 6 });
            }
            shown[id] = now;
        }
    }
    stream.on('run', data => { latest = JSON.parse(data); paint(); });
    function show(instance) {
        drawer.hidden = true;
        task = null;
        current = instance;
        drawn = null;
        latest = null;
        shown = {};
        called = {};
        nav.hidden = trail.length < 2;
        nav.replaceChildren(...trail.flatMap((step, i) => {
            const link = i === trail.length - 1 ? document.createElement('strong') : Object.assign(document.createElement('a'), {
                href: '#', onclick: event => { event.preventDefault(); trail.length = i + 1; show(step.id); },
            });
            link.textContent = step.name;
            return i ? [' › ', link] : [link];
        }));
        follow();
        fetch('/runs/' + instance + '/diagram.bpmn').then(response => response.text()).then(xml => viewer.importXML(xml)).then(() => {
            if (current !== instance) return;
            canvas.zoom('fit-viewport');
            drawn = instance;
            paint();
        });
    }
    viewer.on('element.click', ({ element }) => {
        if (element.type === 'bpmn:CallActivity' && called[element.id]) {
            trail.push({ id: called[element.id], name: element.businessObject.name || element.id });
            show(called[element.id]);
        } else if (element.type.endsWith('Task')) open(element.id);
    });

    // The Task drawer follows its Task, patching only the parts that changed and replacing a changed one with a comment
    // box, so a comment being typed stays, and removing the parts that are gone, such as Send once the session ends or
    // the action once it is handled. Its Latest output keeps scrolled to the end.
    const drawer = document.getElementById('drawer'), parts = document.getElementById('parts');
    let received = {};
    function open(id) {
        task = id;
        received = {};
        parts.replaceChildren();
        drawer.hidden = false;
        follow();
    }
    stream.on('drawer', html => {
        const template = document.createElement('template');
        template.innerHTML = html;
        const now = [...template.content.children];
        for (const old of [...parts.children]) {
            if (now.some(part => part.id === old.id)) continue;
            old.remove();
            delete received[old.id];
        }
        now.forEach((part, i) => {
            if (received[part.id] === part.outerHTML) return;
            received[part.id] = part.outerHTML;
            const old = document.getElementById(part.id);
            if (!old) parts.insertBefore(part, parts.children[i] ?? null);
            else if (old.querySelector('textarea')) old.replaceWith(part);
            else stream.patch(old, part.innerHTML);
        });
        document.querySelector('#drawer-output .tr')?.scrollTo(0, 1e6);
    });
    const close = () => { task = null; drawer.hidden = true; follow(); };
    document.getElementById('close').onclick = close;
    addEventListener('keydown', event => { if (event.key === 'Escape' && !drawer.hidden) close(); });
    show(run);
</script>
</main>
</body>
</html>
