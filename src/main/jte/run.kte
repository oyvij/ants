@import ants.stateName
@import ants.tokens
@param run: org.operaton.bpm.engine.history.HistoricProcessInstance
@param variables: Map<String, String>
@param agentTasks: Map<String, String>
@param kept: String?
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param transcripts: Map<String, Long>
@param report: Boolean
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="${colorScheme}">
    <title>${run.processDefinitionName ?: run.processDefinitionKey} · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/base-navigated-viewer.css">
    <style>
        .ants-done .djs-visual > :first-child { stroke: #2e7d32 !important; fill: #e8f5e9 !important; }
        .ants-running .djs-visual > :first-child { stroke: #1565c0 !important; fill: #e3f2fd !important; }
        .ants-queued .djs-visual > :first-child { stroke: #888 !important; stroke-dasharray: 4 !important; }
        .ants-waiting .djs-visual > :first-child { stroke: #e65100 !important; fill: #fff3e0 !important; }
        .ants-badge { background: #333; color: #fff; border-radius: 8px; padding: 0 5px; font-size: 12px; white-space: nowrap; }
        #drawer { position: fixed; top: 0; right: 0; width: min(28rem, 100%); height: 100%; overflow: auto; padding: 1rem;
            box-sizing: border-box; background: Canvas; border-left: 1px solid #888; }
        .completed { text-decoration: line-through; }
    </style>
</head>
<body>
@template.nav()
<p><a href="/runs">Runs</a></p>
<h1><a href="/processes/${run.processDefinitionKey}">${run.processDefinitionName ?: run.processDefinitionKey}</a></h1>
<p id="state">State: ${run.stateName}</p>
@if(report)
<p><a href="/runs/${run.id}/report">Report</a></p>
@endif
@if(kept != null)
<form method="post" action="/runs/${run.id}/dismiss">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <p>The Run workspace is kept at <code>${kept}</code> until you dismiss it. <button>Dismiss</button></p>
</form>
@endif
<nav id="trail" hidden></nav>
<div id="diagram" style="height: 60vh"></div>
<aside id="drawer" hidden><button id="close" aria-label="Close">✕</button><div id="parts"></div></aside>
@if(agentTasks.isNotEmpty())
<h2>Agent Tasks</h2>
<dl>
@for((task, state) in agentTasks)
    <dt>${task}</dt><dd>${state}</dd>
@endfor
</dl>
@endif
@if(transcripts.isNotEmpty())
<h2>Transcripts · ${tokens(transcripts.values.sum())}</h2>
<ul>
@for((task, count) in transcripts)
    <li><a href="/runs/${run.id}/tasks/${task}/transcript">${task}</a> · ${tokens(count)}</li>
@endfor
</ul>
@endif
<h2>Variables</h2>
<dl>
@for((name, value) in variables)
    <dt>${name}</dt><dd><code>${value}</code></dd>
@endfor
</dl>
<script src="/vendor/camunda-bpmn-js/base-navigated-viewer.production.min.js"></script>
<script>
    // The live diagram: each update patches only the elements whose state, badge or Round changed, so an open drawer stays.
    // Clicking a call activity shows the called Process's live diagram in its place; the trail above it leads back.
    const run = '${run.id}';
    const viewer = new BpmnNavigatedViewer({ container: '#diagram' });
    const canvas = viewer.get('canvas'), overlays = viewer.get('overlays'), registry = viewer.get('elementRegistry');
    const trail = [{ id: run, name: document.querySelector('h1').textContent }], nav = document.getElementById('trail');
    let current = run, shown = {}, called = {}, updates = null;
    function show(instance) {
        updates?.close();
        following?.close();
        drawer.hidden = true;
        current = instance;
        shown = {};
        called = {};
        nav.hidden = trail.length < 2;
        nav.replaceChildren(...trail.flatMap((step, i) => {
            const link = i === trail.length - 1 ? document.createElement('strong') : Object.assign(document.createElement('a'), {
                href: '#', onclick: event => { event.preventDefault(); trail.length = i + 1; show(step.id); },
            });
            link.textContent = step.name;
            return i ? [' › ', link] : [link];
        }));
        fetch('/runs/' + instance + '/diagram.bpmn').then(response => response.text()).then(xml => viewer.importXML(xml)).then(() => {
            if (current !== instance) return;
            canvas.zoom('fit-viewport');
            updates = new EventSource('/runs/' + instance + '/live');
            updates.onmessage = event => {
                const live = JSON.parse(event.data);
                called = live.called;
                if (instance === run) document.getElementById('state').textContent = 'State: ' + live.state;
                for (const [id, now] of Object.entries(live.elements)) {
                    const before = shown[id];
                    if (!registry.get(id) || JSON.stringify(before) === JSON.stringify(now)) continue;
                    if (before) canvas.removeMarker(id, 'ants-' + before.state);
                    canvas.addMarker(id, 'ants-' + now.state);
                    overlays.remove({ element: id, type: 'ants' });
                    const badge = [now.badge, now.round > 1 ? '↻ ' + now.round : null].filter(Boolean).join(' · ');
                    if (badge) {
                        const span = document.createElement('span');
                        span.className = 'ants-badge';
                        span.textContent = badge;
                        overlays.add(id, 'ants', { position: { bottom: 8, right: 8 }, html: span });
                    }
                    shown[id] = now;
                }
            };
        });
    }
    viewer.on('element.click', ({ element }) => {
        if (element.type === 'bpmn:CallActivity' && called[element.id]) {
            trail.push({ id: called[element.id], name: element.businessObject.name || element.id });
            show(called[element.id]);
        } else if (element.type.endsWith('Task')) open(element.id);
    });

    // The Task drawer follows its Task over SSE, replacing only the parts that changed, so a comment being typed stays,
    // and removing the parts that are gone, such as Send once the session ends or the action once it is handled.
    const drawer = document.getElementById('drawer'), parts = document.getElementById('parts');
    let following = null, received = {};
    function open(task) {
        following?.close();
        received = {};
        parts.replaceChildren();
        drawer.hidden = false;
        following = new EventSource('/runs/' + current + '/tasks/' + encodeURIComponent(task) + '/drawer');
        following.onmessage = event => {
            const template = document.createElement('template');
            template.innerHTML = event.data;
            const now = [...template.content.children];
            for (const old of [...parts.children]) {
                if (now.some(part => part.id === old.id)) continue;
                old.remove();
                delete received[old.id];
            }
            now.forEach((part, i) => {
                if (received[part.id] === part.outerHTML) return;
                received[part.id] = part.outerHTML;
                const old = document.getElementById(part.id);
                old ? old.replaceWith(part) : parts.insertBefore(part, parts.children[i] ?? null);
            });
        };
    }
    document.getElementById('close').onclick = () => { following?.close(); drawer.hidden = true; };
    show(run);
</script>
</body>
</html>
