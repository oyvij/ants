@import ants.stateName
@import ants.tokens
@param run: org.operaton.bpm.engine.history.HistoricProcessInstance
@param variables: Map<String, String>
@param agentTasks: Map<String, String>
@param transcripts: Map<String, Long>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>${run.processDefinitionName ?: run.processDefinitionKey} · Ants</title>
</head>
<body>
@template.nav()
<p><a href="/runs">Runs</a></p>
<h1><a href="/processes/${run.processDefinitionKey}">${run.processDefinitionName ?: run.processDefinitionKey}</a></h1>
<p>State: ${run.stateName}</p>
@if(agentTasks.isNotEmpty())
<h2>Agent Tasks</h2>
<dl>
@for((task, state) in agentTasks)
    <dt>${task}</dt><dd>${state}</dd>
@endfor
</dl>
@endif
@if(transcripts.isNotEmpty())
<h2>Transcripts · ${tokens(transcripts.values.sum())}</h2>
<ul>
@for((task, count) in transcripts)
    <li><a href="/runs/${run.id}/tasks/${task}/transcript">${task}</a> · ${tokens(count)}</li>
@endfor
</ul>
@endif
<h2>Variables</h2>
<dl>
@for((name, value) in variables)
    <dt>${name}</dt><dd><code>${value}</code></dd>
@endfor
</dl>
</body>
</html>
