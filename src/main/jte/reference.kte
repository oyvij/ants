@param skill: String
@param reference: ants.SkillReference
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${reference.path} · ${skill} · Skills · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/skills">Skills</a> / <a href="/skills/${skill}">${skill}</a> / ${reference.path}</div>
<div class="ph"><h1><code>${reference.path}</code></h1><div class="acts"><span class="muted small">Read-only</span></div></div>
<div class="card">
    <div class="fld"><label class="f" for="reference-text">${reference.path}</label>
        <textarea id="reference-text" rows="20" placeholder="e.g. # Format&#10;One finding per line." data-markdown readonly data-tall>${reference.text}</textarea></div>
</div>
</main>
</body>
</html>
