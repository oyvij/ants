@param entries: List<ants.Entry>
@if(entries.isEmpty())
<p>Nothing is waiting on you.</p>
@else
<table>
    <tr><th></th><th>Process</th><th>Run</th><th>Task</th><th>Summary</th><th>Waiting</th></tr>
@for(entry in entries)
    <tr><td>${entry.icon} ${entry.tag}</td><td>${entry.process}</td><td>@if(entry.run.isNotEmpty())<a href="/runs/${entry.run}">${entry.run}</a>@endif</td><td><a href="${entry.href}">${entry.task}</a></td><td>${entry.summary}</td><td>${entry.waited}</td></tr>
@endfor
</table>
@endif
