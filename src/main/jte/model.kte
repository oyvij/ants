@param chip: ants.ModelChip?
@if(chip != null) <span class="model" title="${chip.detail}">@if(chip.cli == "codex")<svg class="i cli-codex" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9l3 3-3 3M12 15h5"/></svg>@else<svg class="i cli-claude" viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4"/></svg>@endif${chip.name}@if(chip.bars > 0) <span class="bars e${chip.bars}" aria-label="${chip.level.effort} effort">@for(i in 1..5)<i></i>@endfor</span>@endif@if(chip.badge != null) <span class="retried">${chip.badge}</span>@endif</span>@endif
