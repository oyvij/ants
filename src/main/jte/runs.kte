@import ants.stateName
@param runs: List<org.operaton.bpm.engine.history.HistoricProcessInstance>
@param names: Map<String, String>
@param colorScheme: String = "light dark"
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Runs · Ants</title>
</head>
<body>
@template.nav()
<h1>Runs</h1>
<table>
    <tr><th>Run</th><th>Process</th><th>State</th><th>Started</th></tr>
@for(run in runs)
    <tr><td><a href="/runs/${run.id}">${names[run.id]}</a></td><td>${run.processDefinitionName ?: run.processDefinitionKey}</td><td><span data-state="${run.stateName}">${run.stateName}</span></td><td>${run.startTime.toString()}</td></tr>
@endfor
</table>
</body>
</html>
