@param entry: ants.TaskEntry
@param changes: List<ants.RepoChanges>
@param comments: List<ants.LineComment>
@param error: String? = null
@param tab: String? = null
@param stories: ants.StorySet? = null
@param checks: ants.StoryChecks? = null
@param story: Int = 0
@param step: Int = 0
@param current: ants.Step? = null
@param refused: String? = null
@param unchanged: List<String> = emptyList()
@param diffs: Map<String, List<ants.FileDiff>> = emptyMap()
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${entry.icon} ${entry.tag} ${ants.Transcript.plain(entry.task)} · Ants</title>
    <script src="/review.js" defer></script>
    <script type="module" src="/highlight.js"></script>
</head>
<body>
@template.nav(shell = shell)
<main class="${if (tab == "story") "full" else null}">
<div class="crumbs"><a href="/runs">Runs</a> / <a href="/runs/${entry.run}">$unsafe{ants.Transcript.inline(entry.runName)}</a> / $unsafe{ants.Transcript.inline(entry.task)}</div>
<div class="ph"><h1>$unsafe{ants.Transcript.inline(entry.task)} <span class="pill p-waiting">Waiting on you</span> @template.tag(entry = entry)</h1>
    <div class="acts"><span class="muted small">User Task</span></div><div class="sub">$unsafe{ants.Transcript.inline(entry.summary)}</div></div>
@if(error != null)<p role="alert">$unsafe{ants.Transcript.inline(error)}</p>@endif
<div class="grid3 repos">
    @for(changed in changes)!{val repo = changed.repo}
    <div class="card"><b class="mono">${repo.repo}</b> <span class="muted small">on ${repo.branch}</span><div class="mono small muted" title="${repo.remote}">${repo.shortRemote}</div>
        <div class="small">${changed.files.size} file${if (changed.files.size == 1) "" else "s"} · <span class="plus">+${changed.added}</span> <span class="minus">−${changed.removed}</span> · ${repo.commits.size} commit${if (repo.commits.size == 1) "" else "s"}</div></div>
    @endfor
</div>
@if(unchanged.isNotEmpty())<div class="small muted unchanged">${unchanged.size} repo${if (unchanged.size == 1) "" else "s"} unchanged: <span class="mono">${unchanged.joinToString(", ")}</span></div>@endif
@if(tab == null)<div class="tabs"><a class="on" href="?tab=repo">By repo</a></div>
@elseif(tab == "story")<div class="tabs"><a class="on" href="?tab=story">Story</a><a href="?tab=repo">By repo</a></div>
@else<div class="tabs"><a href="?tab=story">Story</a><a class="on" href="?tab=repo">By repo</a></div>
@endif
@if(refused != null)<p role="alert">$unsafe{ants.Transcript.inline(refused)}</p>@endif
@if(stories != null)
<div class="storyview">
    @template.storyspine(entry = entry, stories = stories, checks = checks, story = story, step = step)
    <div id="walkMain">
        @if(current == null)
        <div class="card" id="stories"><div class="muted small">Story set</div><h3>$unsafe{ants.Transcript.inline(stories.title)}</h3>
            @for(i in stories.stories.indices)!{val s = stories.stories[i]}
            <div class="sover"><a href="?tab=story&story=${i + 1}&step=1"><b>$unsafe{ants.Transcript.inline(s.name)}</b></a> <span class="muted small">${s.steps.size} step${if (s.steps.size == 1) "" else "s"}</span><div class="small">$unsafe{ants.Transcript.inline(s.premise)}</div>
                <div class="small muted">$unsafe{ants.Transcript.inline(s.steps.joinToString(" → "))}</div></div>
            @endfor
            <div class="help">Pick a story to walk it one step at a time.</div></div>
        @else!{val s = stories.stories[story - 1]; val at = "$story-$step"}
        <form id="walkto" method="get"><input type="hidden" name="tab" value="story"><input type="hidden" name="story" value="${story}"></form>
        <form id="walkall" method="get"><input type="hidden" name="tab" value="story"></form>
        <section class="walkstory" data-story="${story}">
            <div class="row walkhead"><b>$unsafe{ants.Transcript.inline(s.name)}</b><span class="muted small">$unsafe{ants.Transcript.inline(s.premise)}</span><span class="grow"></span><button form="walkall" class="ghost small" data-all>All stories</button></div>
            <div class="walksteps">
            <div class="step" data-step="${step}">
                <div class="cfile"><span class="mono"><b>${current.repo}</b> · ${current.path}</span><span class="grow"></span><label class="small row"><input type="checkbox" class="showdiff"> Show the diff</label></div>
                <div class="code" data-file="${current.path}">@for(line in current.code)<div class="${line.css}"><span class="ln">${line.number}</span><span class="bar"></span><span class="tx">${line.text}</span></div>@endfor</div>
                <div class="band">
                    <div class="claim">@if(current.stale != null)<span class="stale">STALE</span> @endif$unsafe{ants.Transcript.inline(current.claim)}</div>
                    @if(current.values.isNotEmpty())<div class="vals">@for(value in current.values)<span class="${if (value.cite != null) "cited" else "inv"}" title="${if (value.cite != null) "from ${value.cite}" else "not found in the code"}">$unsafe{ants.Transcript.inline(value.name)}: <b>$unsafe{ants.Transcript.inline(value.value)}</b> <span class="small">[$unsafe{ants.Transcript.inline(value.provenance)}]</span></span>@endfor</div>@endif
                    <div class="kv small details">
                        <span class="k">Why</span><span>$unsafe{ants.Transcript.inline(current.why)}</span>
                        @if(current.flow != null)<span class="k">Flow</span><span>in: $unsafe{ants.Transcript.inline(current.flow!!.first)}<br>out: $unsafe{ants.Transcript.inline(current.flow!!.second)}</span>@endif
                        @if(current.nudge != null)<span class="k">Nudge</span><span>$unsafe{ants.Transcript.inline(current.nudge!!)}</span>@endif
                        @if(current.stale != null)<span class="k">Stale</span><span>Written against<br><code>${current.stale}</code><br>Now<br><code>${current.now}</code></span>@endif
                    </div>
                    @for(k in comments.indices)!{val comment = comments[k]}@if(comment.story == s.name && comment.step == step)<form class="row scomment" method="post" action="/notifications/${entry.id}/comments"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="tab" value="story"><input type="hidden" name="at" value="${at}"><span class="grow"><b>${comment.type}</b> <span class="cbody">$unsafe{ants.Transcript.inline(comment.body)}</span></span><button class="ghost small" name="remove" value="${k}">Remove</button></form>@endif@endfor
                    <form class="row stepcomment" method="post" action="/notifications/${entry.id}/comments">
                        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                        <input type="hidden" name="story" value="${s.name}">
                        <input type="hidden" name="step" value="${step}">
                        <input type="hidden" name="repo" value="${current.repo}">
                        <input type="hidden" name="file" value="${current.file}">
                        <input type="hidden" name="side" value="${current.side}">
                        <input type="hidden" name="from" value="${current.from}">
                        <input type="hidden" name="to" value="${current.to}">
                        <input type="hidden" name="tab" value="story">
                        <input type="hidden" name="at" value="${at}">
                        <label class="cap">Type<select name="type">@for(type in ants.LineComment.TYPES)<option>${type}</option>@endfor</select></label>
                        <label class="cap grow">Comment<textarea name="body" rows="3" placeholder="e.g. Why three retries, not five?" required></textarea></label>
                        <button class="primary">Add</button>
                    </form>
                    <div class="bandacts"><button form="walkto" name="step" value="${step - 1}" data-go="-1" disabled="${step == 1}">◀ Back</button><button form="walkto" name="step" value="${step + 1}" data-go="1" disabled="${step == s.steps.size}">Next ▶</button>
                        <span class="grow"></span><button type="button" class="ghost" data-details>Why, flow, nudge</button>
                        <button type="button" class="ghost" data-comment>Comment on this step</button></div>
                </div>
            </div>
            </div>
        </section>
        @endif
    </div>
</div>
@elseif(tab != "story")
<div class="walk">
    <details class="files fold"><summary>Files</summary><nav>@for(changed in changes)<b class="small mono">${changed.repo.repo}</b>@for(k in changed.files.indices)<a class="mono" href="#f-${changed.repo.repo}-${k + 1}">${changed.files[k].path.substringAfterLast('/')}</a>@endfor
    @endfor</nav></details>
    <div>
    @for(changed in changes)!{val repo = changed.repo}
    <div class="card" data-repo="${repo.repo}">
        <div class="row"><b class="mono">${repo.repo}</b><span class="mono small muted" title="${repo.remote}">${repo.shortRemote}</span><code>${repo.branch}</code>
            <span class="muted small">since ${repo.base ?: "the start: the remote has no default branch"}</span><span class="grow"></span>
            <span class="small">${changed.files.size} file${if (changed.files.size == 1) "" else "s"} · <span class="plus">+${changed.added}</span> <span class="minus">−${changed.removed}</span></span></div>
        <div class="commits">@for(commit in repo.commits)<div class="small"><span class="mono muted">${commit["sha"]?.take(7)}</span> $unsafe{ants.Transcript.inline(commit["subject"])}</div>@endfor</div>
        !{val files = diffs[repo.repo]}
        @if(files != null)@template.repodiff(repo = repo.repo, files = files)
        @else<div class="lazydiff" data-src="/notifications/${entry.id}/diff?repo=${repo.repo}"><a href="?${if (tab != null) "tab=repo&" else ""}repo=${repo.repo}#f-${repo.repo}-1">Show the diff</a></div>
        @endif
    </div>
    @endfor
    <form method="post" action="/notifications/${entry.id}/comments" id="line-comment" class="card">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        @if(tab != null)<input type="hidden" name="tab" value="repo">@endif
        <div class="help">Click a line number to comment on it, and shift-click another to take in the lines between.</div>
        <div class="lc">
            <label class="cap">Repo<input name="repo" placeholder="e.g. api" required></label>
            <label class="cap">File<input name="file" placeholder="e.g. repos/api/Retry.kt" required></label>
            <label class="cap">Side<select name="side"><option>new</option><option>old</option></select></label>
            <label class="cap">Lines<input name="from" type="number" min="1" placeholder="e.g. 12" required></label>
            <label class="cap">to<input name="to" type="number" min="1" placeholder="e.g. 14"></label>
            <label class="cap">Type<select name="type">@for(type in ants.LineComment.TYPES)<option>${type}</option>@endfor</select></label>
        </div>
        <div class="row"><label class="cap grow">Comment<textarea name="body" rows="3" placeholder="e.g. This retries an invoice that was already paid." required></textarea></label><button class="primary">Add the comment</button></div>
    </form>
    </div>
</div>
@endif
@if(comments.isNotEmpty())
<div id="comments"><b class="small">Comments (${comments.size})</b>
    @for(k in comments.indices)!{val comment = comments[k]; val at = stories?.stories?.indexOfFirst { it.name == comment.story } ?: -1}
    <form class="row small remove" method="post" action="/notifications/${entry.id}/comments">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        @if(tab != null)<input type="hidden" name="tab" value="${tab}">@endif
        <span class="tag t-${comment.type}">${comment.type.lowercase().replaceFirstChar(Char::uppercase)}</span>
        <span>@if(at >= 0)<a href="?tab=story&story=${at + 1}&step=${comment.step}">$unsafe{ants.Transcript.inline(comment.story)} › $unsafe{ants.Transcript.inline(stories!!.stories[at].steps.getOrNull(comment.step!! - 1))}</a> @elseif(comment.story != null)$unsafe{ants.Transcript.inline(comment.story)} step ${comment.step} @endif<span class="mono">${comment.file}:${comment.from}-${comment.to} (${comment.side})</span>: <span class="cbody">$unsafe{ants.Transcript.inline(comment.body)}</span></span>
        <span class="grow"></span><button class="ghost small" name="remove" value="${k}">Remove</button>
    </form>
    @endfor
</div>
@endif
<form method="post" action="/notifications/${entry.id}">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <div class="fld"><label class="f" for="comment">Overall comment</label>
        <div class="help">Send back needs this or a comment on a step or a line: the Task it sends back to resumes with all of them.</div>
        <textarea id="comment" name="comment" rows="5" placeholder="e.g. Cap the retries before this ships." data-markdown></textarea></div>
    <div class="composer"><div><span class="grow muted small">Nothing is pushed until you approve.</span><button name="action" value="send-back" data-pending="Sending back…">Send back</button>
        <button class="primary" name="action" value="approve" data-pending="Approving…">Approve</button></div></div>
</form>
</main>
</body>
</html>
