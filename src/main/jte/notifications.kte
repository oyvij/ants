@param entries: List<ants.Entry>
@param colorScheme: String = "light dark"
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="${colorScheme}">
    <title>Notification list · Ants</title>
</head>
<body>
@template.nav()
<h1>Notification list</h1>
@if(entries.isEmpty())
<p>Nothing is waiting on you.</p>
@else
<table>
    <tr><th></th><th>Process</th><th>Run</th><th>Task</th><th>Summary</th><th>Waiting</th></tr>
@for(entry in entries)
    <tr><td>${entry.icon} ${entry.tag}</td><td>${entry.process}</td><td><a href="/runs/${entry.run}">${entry.run}</a></td><td><a href="/notifications/${entry.id}">${entry.task}</a></td><td>${entry.summary}</td><td>${entry.waited}</td></tr>
@endfor
</table>
@endif
</body>
</html>
