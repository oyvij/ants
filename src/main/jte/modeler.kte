@import ants.modelerFacts
@param name: String
@param src: String
@param action: String
@param saveLabel: String = "Publish"
@param copy: String? = null
@param list: String = "Processes"
@param page: String? = null
@param note: String? = null
@param builder: String? = null
@param column: ants.BuilderColumn = ants.BuilderColumn.PROCESS
@param draft: ants.DraftHead? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${name} · Modeler · Ants</title>
    <link rel="stylesheet" href="/vendor/camunda-bpmn-js/assets/camunda-platform-modeler.css">
</head>
<body>
@template.nav(shell = shell)
<main class="full">
<div class="crumbs"><a href="/${list.lowercase()}">${list}</a> / @if(page != null)<a href="${page}">${name}</a>@else${name}@endif / Diagram</div>
<div class="ph"><h1>${name}</h1>
@if(draft != null)
    @template.drafthead(draft = draft)
@endif
    <div class="acts">
@if(note != null)
        <span class="muted small">${note}</span>
@endif
@if(copy != null)
        <form method="post" action="${copy}">
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <span class="muted small">Ants' own, read-only.</span> <button>Copy</button> <span class="muted small">makes your own.</span>
        </form>
@endif
@if(draft?.state == ants.DraftState.CHANGED)
        <form method="post" action="${draft.endpoint.removeSuffix("/draft")}/discard" data-leaves-draft><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Discard Draft</button></form>
@elseif(draft?.state == ants.DraftState.DRAFT_ONLY)
        <form method="post" action="${draft.endpoint.removeSuffix("/draft")}/delete" data-leaves-draft><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="danger">Delete</button></form>
@endif
@if(builder != null)
        <button type="button" id="builder-toggle" aria-controls="builder" aria-pressed="true">${column.title}</button>
@endif
        <button class="primary" id="save" data-action="${action}" hidden="${copy != null}">${saveLabel}</button>
    </div>
</div>
<p id="refusal" role="alert"></p>
<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
<div class="modelerWrap">
    <div id="canvas" data-src="${src}" data-autosave="${draft?.endpoint}" data-version="${draft?.version?.toString()}" data-facts="${modelerFacts}" class="dia modeler"></div>
    <div class="props">
        <div id="explain"></div>
        <div class="checks">
            <div class="row"><b>Checks</b><span class="grow"></span><span id="summary"></span></div>
            <ul id="checks" aria-label="Checks"></ul>
        </div>
    </div>
@if(builder != null)
    <aside class="pb" id="builder" aria-label="${column.title}" data-path="${column.path}" data-template="${if (column == ants.BuilderColumn.TEMPLATE) name else null}" data-off="${builder.ifEmpty { null }}">
        <div id="pb-dialog" class="tr"><p class="muted">@if(builder.isNotEmpty())${builder}@else${column.intro}@endif</p><div id="pb-live"></div></div>
        <form id="pb-form" hidden="${builder.isNotEmpty()}">
            <label class="f" for="pb-message">Message to the ${column.title}</label>
            <textarea id="pb-message" name="message" data-markdown data-enter-sends required placeholder="${column.placeholder}"></textarea>
            <div class="row"><span class="grow muted small" id="pb-error" role="alert"></span><button type="button" id="pb-stop" hidden>Stop</button><button class="primary" id="pb-send">Send</button></div>
        </form>
    </aside>
@endif
</div>
</main>
<script src="/vendor/camunda-bpmn-js/camunda-platform-modeler.production.min.js"></script>
<script type="module" src="/modeler.js"></script>
</body>
</html>
