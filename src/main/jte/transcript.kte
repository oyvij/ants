@param run: String
@param runName: String
@param task: String
@param transcript: ants.Transcript
@param view: ants.TaskView
@param offset: Long
@param sendHint: String?
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${view.name} · Transcript · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div id="taskhead">@template.taskhead(view = view, run = run, runName = runName, tokens = transcript.html("tokens"))</div>
$unsafe{transcript.html("sofar")}
$unsafe{transcript.html("subagents")}
@if(view.state == "round" && view.asked != null)
<div class="card round">This Task asked Round ${view.round}. <a href="/notifications/${view.asked.id}">Answer the Round</a> and its session resumes.</div>
@endif
<div class="tr">
<div id="entries" data-from="${offset}">
@for(entry in transcript.roots)
$unsafe{entry}
@endfor
</div>
$unsafe{transcript.html("live")}
$unsafe{transcript.html("status")}
</div>
@if(error != null)<p role="alert">${error}</p>@endif
@if(sendHint != null)
<div class="composer"><form method="post" action="/runs/${run}/tasks/${task}/transcript/send">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <div class="grow"><label class="f" for="message">Message to the Agent</label><textarea id="message" name="message" data-markdown required placeholder="e.g. Use the existing retry helper. ${sendHint}"></textarea></div>
    <button formaction="/runs/${run}/tasks/${task}/transcript/stop" formnovalidate data-pending="Stopping…">Stop</button>
    <button class="primary" data-pending="Sending…">Send</button>
</form></div>
@endif
<script type="module">
    // Follows the Transcript from where this page's copy ends: an entry that changed is replaced, a new one fades in
    // (a Subagent's in its block), and the status, the streaming text, the tokens, the chips and So far are patched.
    const entries = document.getElementById('entries');
    stream.on('taskhead', html => stream.patch(document.getElementById('taskhead'), html));
    stream.on('transcript', html => {
        const template = document.createElement('template');
        template.innerHTML = html;
        const element = template.content.firstElementChild;
        const old = document.getElementById(element.id);
        if (old && !/^e\d+$/.test(element.id)) stream.morph(old, element);
        else if (old) old.replaceWith(element);
        else {
            element.classList.add('new');
            (element.dataset.in ? document.querySelector('#' + element.dataset.in + ' > div') : entries).append(element);
        }
    });
    stream.follow('transcript=' + encodeURIComponent('${run}/${task}') + '&from=' + entries.dataset.from);
</script>
</main>
</body>
</html>
