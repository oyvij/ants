@param processes: List<org.operaton.bpm.engine.repository.ProcessDefinition>
@param rows: List<ants.ProcessRow>
@param drafts: List<ants.Draft> = emptyList()
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Processes · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Processes</h1><div class="acts"><button class="primary" onclick="document.getElementById('new-process').showModal()">New Process</button></div></div>
@if(error != null)<p role="alert">${error}</p>@endif
<table id="processes">
    <tr><th>Process</th><th>From</th><th>Vault · Source map</th><th>Schedule</th><th>Check</th><th>Live Runs</th><th></th></tr>
@for(row in rows)
    !{val key = row.process.key}
    <tr class="click" data-href="/processes/${key}">
        <td><a href="/processes/${key}"><b>${row.process.name ?: key}</b></a>@template.draftmark(state = row.state, list = true)</td>
        <td class="muted small">${if (row.shipped) "shipped" else "you"}</td>
        <td class="muted small">${row.profile?.vault ?: "—"} · ${row.profile?.sourceMap ?: "—"}</td>
        <td class="small">@if(row.scheduleCount > 0)⏰ ${row.scheduleCount}@endif</td>
        <td>@if(row.ready)<span class="pill p-ready">Ready</span>@else<span class="pill p-failed">Can't start</span>@endif</td>
        <td class="muted">${row.live}</td>
        <td><a href="/processes/${key}/edit">Edit diagram</a></td>
    </tr>
@endfor
@for(draft in drafts)
    <tr class="click" data-href="/processes/${draft.id}/edit">
        <td><a href="/processes/${draft.id}/edit"><b>${draft.name}</b></a>@template.draftmark(state = ants.DraftState.DRAFT_ONLY, list = true)</td>
        <td class="muted small">you</td><td></td><td></td><td></td><td></td>
        <td><a href="/processes/${draft.id}/edit">Edit diagram</a></td>
    </tr>
@endfor
</table>
<dialog class="modal" id="new-process">
    <form method="dialog" class="mh"><b>New Process</b><span class="sp"></span><span class="muted small">Esc to close</span><button class="ghost" title="Close" aria-label="Close">✕</button></form>
    <div class="mb">
        <form method="post" action="/processes/new">
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <div class="fld"><label class="f" for="new-name">Name</label><div class="help">The Process's name; the modeler opens on it, a Draft until you publish it.</div><input id="new-name" name="name" placeholder="e.g. Nightly knowledge sweep"></div>
            <div class="fld"><label class="f" for="new-from">Start from</label><div class="help">A blank diagram, or a copy of a Process.</div><select id="new-from" name="from">
                <option value="">Blank</option>
@for(process in processes)
                <option value="${process.key}">${process.name ?: process.key}</option>
@endfor
            </select></div>
            <div class="go"><button class="primary">＋ New Process</button></div>
        </form>
        <form method="post" action="/processes" enctype="multipart/form-data" class="subsec">
            <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
            <div class="fld"><label class="f" for="new-file">Import a BPMN file</label><div class="help">Deployed through the Checks, like Publish.</div><input type="file" id="new-file" name="file" accept=".bpmn" required></div>
            <div class="go"><button>Import</button></div>
        </form>
    </div>
</dialog>
</main>
</body>
</html>
