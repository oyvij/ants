@param file: ants.Tracked
@param text: String
@param article: String?
@param error: String? = null
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Edit ${file.title} · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/tickets">Tickets</a> / <a href="${file.href}">${file.title}</a> / Edit</div>
@if(error != null)<p role="alert">${error}</p>@endif
@if(article != null)$unsafe{article}@endif
<form method="post">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <input type="hidden" name="version" value="${file.version}">
    <label class="f" for="text">The Ticket, in Markdown</label>
    <textarea id="text" name="text" rows="30" cols="100" placeholder="e.g. # Say hello&#10;&#10;Status: ready-for-agent" data-markdown data-tall>
${text}</textarea>
    <p><button class="primary">Save</button></p>
</form>
</main>
</body>
</html>
