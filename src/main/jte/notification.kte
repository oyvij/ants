@param entry: ants.TaskEntry
@param details: String?
@param view: ants.TaskView
@param error: String? = null
@param permission: ants.PermissionRequest? = null
@param always: Boolean = false
@param _csrf: org.springframework.security.web.csrf.CsrfToken
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>${entry.icon} ${entry.tag} ${entry.task} · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
@template.taskhead(view = view, run = entry.run, runName = entry.runName, tokens = view.context)
@if(details != null)
<div class="card"><h3>@if(entry.tag == "[stuck]")What it needs@elseif(entry.tag == "[stopped]")Where it stopped@else Why it failed@endif</h3>@if(entry.tag == "[stuck]")$unsafe{ants.Transcript.markdown(details)}@else<pre>${details}</pre>@endif</div>
@endif
<details class="session">
    <summary class="small">The session so far</summary>
    <div class="tr">
@if(view.transcript != null)
@for(line in view.transcript.roots)
$unsafe{line}
@endfor
@else
        <div class="ants">No launch yet.</div>
@endif
        <p><a href="/runs/${entry.run}/tasks/${entry.taskId}/transcript">Full Transcript →</a></p>
    </div>
</details>
@if(error != null)<p role="alert">${error}</p>@endif
@if(permission != null)
<form method="post" action="/notifications/${entry.id}/permission" class="card" id="permission" role="dialog" aria-labelledby="permission-head">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <h3 id="permission-head">Permission request</h3>
    $unsafe{ants.Transcript.markdown(permission.summary)}
    <div class="kv"><span class="k">Agent</span><span>${permission.agent}</span><span class="k">Tool</span><span>${permission.tool}</span>@if(permission.target != null)<span class="k">@if(permission.tool == "Bash")Command@else On@endif</span><code>${permission.target}</code>@endif</div>
    @if(permission.allowable)
    <div class="fld"><label class="f" for="limit">Limit</label>
        <div class="help">The rule to allow. Edit it to allow more or less.</div>
        <input id="limit" name="limit" class="mono" value="${permission.limit}" placeholder="e.g. Bash(cargo *)" required></div>
    @else
    <p id="permission-why">No allow rule can help: $unsafe{ants.Transcript.markdown(permission.why!!).removePrefix("<p>").removeSuffix("</p>\n")}.</p>
    @endif
    <div class="composer"><div>
        <span class="grow"></span>
        <button name="choice" value="deny" formnovalidate>Don't allow</button>
        @if(permission.allowable)<button name="choice" value="task">Allow for this Task</button>@endif
        @if(always)<button class="primary" name="choice" value="always">Always allow</button>@endif
    </div></div>
</form>
@else
<form method="post">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    <div class="fld"><label class="f" for="instruction">Your instruction</label>
        <div class="help">Required to continue the session. Optional when starting fresh.</div>
        <textarea id="instruction" name="instruction" placeholder="e.g. Both providers, Stripe first." data-markdown required></textarea></div>
    <div class="composer"><div>
        @if(entry.tag == "[failed]")<button class="danger" name="action" value="cancel" formnovalidate>Cancel the Run</button>@endif
        <span class="grow"></span>
        <button name="action" value="fresh" formnovalidate>Start fresh</button>
        <button class="primary" name="action" value="continue">Continue the session</button>
    </div></div>
</form>
@endif
</main>
</body>
</html>
