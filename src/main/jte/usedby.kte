@param dependents: ants.Dependents
@param none: String
<span class="usedby">Used by: @if(dependents.none)${none}@else@for(agent in dependents.agents.withIndex())@if(agent.index > 0), @endif<a href="/agents/${agent.value}">${agent.value}</a>@endfor@for(process in dependents.processes.withIndex())@if(process.index > 0 || dependents.agents.isNotEmpty()), @endif<a href="/processes/${process.value.key}">${process.value.name ?: process.value.key}</a>@if(process.value.id in dependents.older) (version ${process.value.version}, which live Runs still run)@endif@endfor@endif</span>
