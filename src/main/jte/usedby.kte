@param dependents: ants.Dependents
@param none: String
<span class="usedby">Used by: @if(dependents.none)$unsafe{ants.Transcript.inline(none)}@else@for(agent in dependents.agents.withIndex())@if(agent.index > 0), @endif<a href="/agents/${agent.value}">$unsafe{ants.Transcript.inline(agent.value)}</a>@endfor@for(process in dependents.processes.withIndex())@if(process.index > 0 || dependents.agents.isNotEmpty()), @endif<a href="/processes/${process.value.key}">$unsafe{ants.Transcript.inline(process.value.name ?: process.value.key)}</a>@if(process.value.id in dependents.older) (version ${process.value.version}, which live Runs still run)@endif@endfor@for(script in dependents.scripts.withIndex())@if(script.index > 0 || dependents.agents.isNotEmpty() || dependents.processes.isNotEmpty()), @endif<a href="/scripts/${script.value}">$unsafe{ants.Transcript.inline(script.value)}</a>@endfor@endif</span>
