@param pauses: Map<String, String>
@param _csrf: org.springframework.security.web.csrf.CsrfToken
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Ants</title>
</head>
<body>
<h1>Home</h1>
<nav><a href="/processes">Processes</a> · <a href="/runs">Runs</a>
@for((cli, until) in pauses)
    <form method="post" action="/pauses/${cli}" style="display: inline">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        · ${cli} paused until ${until} <button>Try now</button>
    </form>
@endfor
</nav>
</body>
</html>
