@param live: Long
@param waiting: Int
@param done: Long
@param entries: List<ants.Entry>
@param working: List<ants.Working>
@param processes: List<org.operaton.bpm.engine.repository.ProcessDefinition>
@param colorScheme: String = "light dark"
@param pauses: Map<String, String>
@param _csrf: org.springframework.security.web.csrf.CsrfToken
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="${colorScheme}">
    <title>Ants</title>
</head>
<body>
@template.nav()
@for((cli, until) in pauses)
<form method="post" action="/pauses/${cli}">
    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
    ${cli} paused until ${until} <button>Try now</button>
</form>
@endfor
<h1>Home</h1>
<div id="live">@template.dashboard(live = live, waiting = waiting, done = done, entries = entries, working = working)</div>
<section id="start-a-run">
<h2>Start a Run</h2>
<ul>
@for(process in processes)
    <li><a href="/processes/${process.key}">${process.name ?: process.key}</a></li>
@endfor
</ul>
</section>
<script>
    new EventSource('/home/live').onmessage = event => document.getElementById('live').innerHTML = event.data;
</script>
</body>
</html>
