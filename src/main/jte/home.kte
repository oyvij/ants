@param live: Long
@param waiting: Int
@param done: Long
@param entries: List<ants.Entry>
@param working: List<ants.Working>
@param coming: List<ants.Schedule>
@param processes: List<org.operaton.bpm.engine.repository.ProcessDefinition>
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Home</h1><div class="acts"><a class="btn primary" href="/processes">Start a Run</a></div></div>
<div id="live">@template.dashboard(live = live, waiting = waiting, done = done, entries = entries, working = working, coming = coming)</div>
<section id="start-a-run">
<h2>Start a Run</h2>
<ul>
@for(process in processes)
    <li><a href="/processes/${process.key}">${process.name ?: process.key}</a></li>
@endfor
</ul>
</section>
<script type="module">
    stream.on('home', html => document.getElementById('live').innerHTML = html);
    stream.follow('home');
</script>
</main>
</body>
</html>
