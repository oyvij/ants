@param run: String
@param html: String
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Report · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="crumbs"><a href="/runs">Runs</a> / <a href="/runs/${run}">Run ${run}</a> / Report</div>
$unsafe{html}
</main>
</body>
</html>
