@param specs: List<ants.SpecRow>
@param colorScheme: String = "light dark"
@param shell: ants.Shell
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    @template.app()
    <meta name="color-scheme" content="${colorScheme}">
    <title>Tickets · Ants</title>
</head>
<body>
@template.nav(shell = shell)
<main>
<div class="ph"><h1>Tickets</h1><div class="sub">Every Spec across Runs, open first, with its Tickets.</div></div>
@if(specs.isEmpty())
<p>No Run has written a Spec yet.</p>
@else
<table class="specs">
    <tr><th>Spec</th><th>Status</th><th>Tickets</th><th>Run</th></tr>
@for(row in specs)
    <tr><td><a href="${row.spec.href}">${row.spec.title}</a></td><td>${row.spec.status ?: "open"}</td><td>${row.done}/${row.tickets.size} done</td><td><a href="/runs/${row.run}">${row.name}</a> · ${row.process}</td></tr>
@endfor
</table>
@endif
</main>
</body>
</html>
