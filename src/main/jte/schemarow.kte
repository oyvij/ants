@param row: ants.SchemaRow
@param at: String
@param depth: Int = 0
<li class="schema-row">
    <div class="row">
        <input class="mono name" name="${at}.name" value="${row.name}" data-field="name" aria-label="Name" placeholder="e.g. text">
        <select name="${at}.type" data-field="type" aria-label="Type">
@for(type in ants.ScriptSchema.TYPES.entries)
            <option value="${type.key}" selected="${type.key == row.type}">${type.value}</option>
@endfor
        </select>
        <input class="grow" name="${at}.description" value="${row.description}" data-field="description" aria-label="Description" placeholder="What it is">
        <label class="nowrap"><input type="checkbox" name="${at}.required" data-field="required" checked="${row.required}"> required</label>
        <button type="button" class="ghost danger" data-remove-row aria-label="Remove ${row.name.ifEmpty { "this row" }}">✕</button>
    </div>
    <div class="schema-fields" hidden="${!row.nests}">
        @template.schemarows(rows = row.rows, prefix = "${at}.rows", depth = depth + 1)
    </div>
</li>
