@import ants.Toast.Kind
@param toast: ants.Toast
@param seq: Long? = null
<div class="toast" role="status" data-kind="${toast.kind.name.lowercase()}" data-seq="${seq}"><svg class="i" viewBox="0 0 24 24">@if(toast.kind == Kind.SUCCESS)<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>@elseif(toast.kind == Kind.INFO)<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>@elseif(toast.kind == Kind.WARNING)<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4M12 17h.01"/>@else<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/>@endif</svg><b>${toast.title}</b><span>${toast.text}</span><button type="button" class="ghost" title="Close" aria-label="Close" onclick="this.closest('.toast').remove()">✕</button></div>
