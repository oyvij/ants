@param shell: ants.Shell
<input type="checkbox" id="menu" autocomplete="off">
<header class="topbar"><a class="logo" href="/"><b>🐜</b>Ants</a><a class="notifications" href="/notifications" title="Notification list"><svg class="i" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><span id="topbar-waiting" class="n">${if (shell.waiting > 0) shell.waiting.toString() else ""}</span></a><label for="menu" title="Menu">☰</label></header>
<nav class="side">
    <div class="logo"><b>🐜</b>Ants</div>
    <span id="history"><button type="button" onclick="history.back()" title="Back" aria-label="Back">←</button><button type="button" onclick="history.forward()" title="Forward" aria-label="Forward">→</button><button type="button" onclick="location.reload()" title="Reload" aria-label="Reload">↻</button></span>
    <a href="/"><svg class="i" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Home</a>
    <a href="/notifications"><svg class="i" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>Notification list<span id="waiting" class="n">${if (shell.waiting > 0) shell.waiting.toString() else ""}</span></a>
    <div class="grp">Work</div>
    <a href="/runs"><svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m10 8.5 5 3.5-5 3.5z"/></svg>Runs<span id="runs" class="m">@template.running(working = shell.working, live = shell.live)</span></a>
    <a href="/processes"><svg class="i" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><path d="M6.5 10v3.5A2.5 2.5 0 0 0 9 16h5"/></svg>Processes</a>
    <a href="/tickets"><svg class="i" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="m8 10 2 2 4-4M8 16h8"/></svg>Tickets</a>
    <div class="grp">Library</div>
    <a href="/agents"><svg class="i" viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V4M9 13v1M15 13v1"/></svg>Agents</a>
    <a href="/skills"><svg class="i" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>Skills</a>
    <a href="/scripts"><svg class="i" viewBox="0 0 24 24"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></svg>Scripts</a>
    <a href="/templates"><svg class="i" viewBox="0 0 24 24"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M4 16V5a1 1 0 0 1 1-1h11"/></svg>Templates</a>
    <div class="bottom">
        <span id="paused"></span>
        <span id="update"></span>
        <form method="post" action="/theme">
            @if(shell.csrf != null)<input type="hidden" name="${shell.csrf.parameterName}" value="${shell.csrf.token}">@endif
            <button class="to-light" name="theme" value="light"><svg class="i" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Light mode</button>
            <button class="to-dark" name="theme" value="dark"><svg class="i" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>Dark mode</button>
        </form>
        <a href="/settings"><svg class="i" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>Settings</a>
        <form method="post" action="/logout">
            @if(shell.csrf != null)<input type="hidden" name="${shell.csrf.parameterName}" value="${shell.csrf.token}">@endif
            <button><svg class="i" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>Log out <span class="m">v${shell.version}</span></button>
        </form>
    </div>
</nav>
!{val toast = shell.toast}
@if(toast != null)@template.toast(toast = toast)@endif
<script src="/shell.js" defer></script>
