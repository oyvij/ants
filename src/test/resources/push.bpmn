<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ship" name="Ship" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:startEvent id="start">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="repos" label="Repos" type="string">
            <operaton:properties>
              <operaton:property id="ants.type" value="repos" />
            </operaton:properties>
          </operaton:formField>
          <operaton:formField id="branch" label="Branch" type="string" />
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="clone" />
    <bpmn:serviceTask id="clone" name="Clone repos" operaton:type="external" operaton:topic="clone-repos">
      <bpmn:extensionElements>
        <operaton:inputOutput>
          <operaton:inputParameter name="repos">${repos}</operaton:inputParameter>
          <operaton:inputParameter name="branch">${branch}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="clone" targetRef="work" />
    <!-- The test commits in the clones, then approves, so Push finds the work done, as after Cut and implement. -->
    <bpmn:userTask id="work" name="Approve the work" />
    <bpmn:sequenceFlow id="f2b" sourceRef="work" targetRef="push" />
    <bpmn:serviceTask id="push" name="Push" operaton:type="external" operaton:topic="push" />
    <bpmn:sequenceFlow id="f3" sourceRef="push" targetRef="end" />
    <bpmn:endEvent id="end" />
  </bpmn:process>
</bpmn:definitions>
