<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="profile" name="Clone and note" isExecutable="true" operaton:historyTimeToLive="180">
    <bpmn:startEvent id="start">
      <bpmn:extensionElements>
        <operaton:formData>
          <operaton:formField id="repos" label="Repos" type="string">
            <operaton:properties>
              <operaton:property id="ants.type" value="repos" />
            </operaton:properties>
          </operaton:formField>
        </operaton:formData>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="clone" />
    <bpmn:serviceTask id="clone" name="Clone repos" operaton:type="external" operaton:topic="clone-repos">
      <bpmn:extensionElements>
        <operaton:inputOutput>
          <operaton:inputParameter name="repos">api</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="clone" targetRef="draft" />
    <bpmn:serviceTask id="draft" name="Note" operaton:type="external" operaton:topic="agent">
      <bpmn:extensionElements>
        <operaton:properties>
          <operaton:property name="ants.agent" value="writer" />
          <operaton:property name="ants.skill" value="draft" />
          <operaton:property name="ants.vault" value="true" />
        </operaton:properties>
        <operaton:inputOutput>
          <operaton:inputParameter name="sourceMap">${sourceMap}</operaton:inputParameter>
        </operaton:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f3" sourceRef="draft" targetRef="end" />
    <bpmn:endEvent id="end" />
  </bpmn:process>
</bpmn:definitions>
