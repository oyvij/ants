#!/bin/bash
# A fake `claude` for tests, run from a copy in its own folder. `--help` prints ./help, if there is one. `auth status`
# prints $CLAUDE_CONFIG_DIR/auth-status.json, or, like a logged-out claude, a loggedIn false and exit 1. Otherwise it
# records its argv, environment, working directory, loaded skills and stdin's first line under ./launches/<skill>.<n> for the nth
# launch of that Skill, appends its working directory to ./launches.log, and plays ./sessions/<skill>.<n>.jsonl, or
# ./sessions/<skill>.jsonl when there is none. The Skill is picked by the first message's leading `/<skill>`, or for `--resume` by the
# session's first launch. A launch that starts with an Assignment, no `/<skill>`, is keyed by its Task's element id,
# $ANTS_TASK, in place of a Skill: tests read `launches/<task id>.<n>` and write `sessions/<task id>.jsonl` for it. A
# launch with none of these, a So far rewrite, plays the Skill `so-far`. Like claude with
# --replay-user-messages, it echoes every stdin message with "isReplay":true.
# A session line `wait <file>` waits until ./<file> exists, `read` reads the next stdin line into the launch's stdin
# record (a control request, such as Stop's interrupt, is not echoed), `stderr <text>` prints to stderr, `exit <code>`
# exits, `write <file> <text>` writes <text> (`\n` for a newline) to <file> in its working directory, as an Agent's
# Write tool would, and `sh <command>` runs a shell command in the working directory, where $launch is the launch's
# record; every other line is printed. $SESSION stands for the --session-id or --resume. A launch that is killed leaves
# ./launches/<skill>.<n>/killed. A launch allowed `mcp__ants__*` is the Process Builder's and plays the Skill
# `process-builder`; its first stdin line is the user's message. A session line `mcp <tool> <json arguments>` calls the
# tool on the `--mcp-config`'s server as claude would: it prints the tool_use, then the tool_result with the server's
# content, and appends the server's response to $launch/mcp.
dir=$(cd "$(dirname "$0")" && pwd)
if [ "$1" = --help ]; then cat "$dir/help" 2>/dev/null; exit 0; fi
if [ "$1 $2" = "auth status" ]; then cat "$CLAUDE_CONFIG_DIR/auth-status.json" 2>/dev/null || { echo '{"loggedIn":false,"authMethod":"none"}'; exit 1; }; exit 0; fi
session= previous= config=
for arg; do case $previous in --session-id|--resume) session=$arg ;; --mcp-config) config=$arg ;; esac; previous=$arg; done
IFS= read -r prompt
skill=$(printf '%s' "$prompt" | sed -nE 's#.*"(content|text)":"/([A-Za-z0-9_.:-]+).*#\2#p')
mkdir -p "$dir/launches" "$dir/skills"
case " $* " in *" mcp__ants__* "*) skill=process-builder ;; esac
if [ "$skill" = process-builder ]; then :
elif [ -n "$skill" ]; then printf '%s' "$skill" > "$dir/skills/$session"
elif [ -n "$session" ] && [ -e "$dir/skills/$session" ]; then skill=$(cat "$dir/skills/$session")
elif [ -n "$ANTS_TASK" ]; then skill=$ANTS_TASK; [ -n "$session" ] && printf '%s' "$skill" > "$dir/skills/$session"
else skill=so-far; fi
calls=0 n=1
while ! mkdir "$dir/launches/$skill.$n" 2>/dev/null; do n=$((n + 1)); done
launch=$dir/launches/$skill.$n
printf '%s\n' "$@" > "$launch/argv"
env > "$launch/env"
pwd > "$launch/cwd"
# The skills an --add-dir's .claude/skills loads, one `<name> <link target>` line each, recorded now: the folder goes
# with the Run workspace.
previous=; for arg; do [ "$previous" = --add-dir ] && for link in "$arg"/.claude/skills/*; do
    [ -L "$link" ] && printf '%s %s\n' "$(basename "$link")" "$(readlink "$link")"; done; previous=$arg; done > "$launch/skills"
# stdin comes last and whole (renamed into place), so a launch whose stdin exists has its full record.
printf '%s\n' "$prompt" > "$launch/stdin.tmp" && mv "$launch/stdin.tmp" "$launch/stdin"
pwd >> "$dir/launches.log"
trap 'touch "$launch/killed"; exit 143' TERM
replay() { printf '%s\n' "${1%\}},\"isReplay\":true}"; }
replay "$prompt"
script=$dir/sessions/$skill.$n.jsonl
[ -e "$script" ] || script=$dir/sessions/$skill.jsonl
while IFS= read -r line <&3; do
    line=${line//\$SESSION/$session}
    case $line in
        "wait "*) while [ ! -e "$dir/${line#wait }" ]; do sleep 0.05; done ;;
        read) IFS= read -r message && printf '%s\n' "$message" >> "$launch/stdin" &&
            case $message in *'"type":"control_request"'*) ;; *) replay "$message" ;; esac ;;
        "stderr "*) printf '%s\n' "${line#stderr }" >&2 ;;
        "sh "*) (eval "${line#sh }") >&2 ;;
        "exit "*) exit "${line#exit }" ;;
        "mcp "*) call=${line#mcp }; tool=${call%% *}; arguments=${call#"$tool"}; arguments=${arguments# }; [ -n "$arguments" ] || arguments='{}'
            calls=$((calls + 1))
            printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"mcp_%s","name":"mcp__ants__%s","input":%s}]},"session_id":"%s"}\n' \
                "$calls" "$tool" "$arguments" "$session"
            url=$(printf '%s' "$config" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')
            auth=$(printf '%s' "$config" | sed -n 's/.*"Authorization":"\([^"]*\)".*/\1/p')
            response=$(curl -s "$url" -H "Authorization: $auth" -H 'Content-Type: application/json' \
                -d "{\"jsonrpc\":\"2.0\",\"id\":$calls,\"method\":\"tools/call\",\"params\":{\"name\":\"$tool\",\"arguments\":$arguments}}")
            printf '%s\n' "$response" >> "$launch/mcp"
            content=${response#*'"result":{"content":'}; content=${content%,'"isError":'*}
            case $response in *'"isError":true'*) failed=true ;; *) failed=false ;; esac
            printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"mcp_%s","content":%s,"is_error":%s}]},"session_id":"%s"}\n' \
                "$calls" "$content" "$failed" "$session" ;;
        "write "*) file=${line#write }; file=${file%% *}; mkdir -p "$(dirname "$file")"; printf '%b' "${line#write "$file" }" > "$file" ;;
        *) printf '%s\n' "$line" ;;
    esac
done 3< "$script"
cat > /dev/null # like claude, it stays until Ants closes stdin
