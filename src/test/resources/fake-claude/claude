#!/bin/bash
# A fake `claude` for tests, run from a copy in its own folder. `--help` prints ./help, if there is one. Otherwise it
# records its argv, environment, working directory and stdin's first line under ./launches/<skill>.<n>.XXXX (the
# Skill's nth launch), appends its working directory to ./launches.log, and plays ./sessions/<skill>.<n>.jsonl, or else
# ./sessions/<skill>.jsonl. The Skill is picked by the hand-off line, or by the session a `--resume` names.
# A session line `wait <file>` waits until ./<file> exists, and `read` reads the next stdin line into the launch's stdin
# record; every other line is printed, with $SESSION as the session id.
dir=$(cd "$(dirname "$0")" && pwd)
if [ "$1" = --help ]; then cat "$dir/help" 2>/dev/null; exit 0; fi
session= resume= previous=
for arg; do
    case $previous in --session-id) session=$arg ;; --resume) session=$arg resume=1 ;; esac
    previous=$arg
done
IFS= read -r prompt
mkdir -p "$dir/launches" "$dir/skills"
if [ -n "$resume" ]; then
    skill=$(cat "$dir/skills/$session")
else
    skill=$(basename "$(printf '%s' "$prompt" | sed -n 's|.*Follow the Skill in \(.*\)/SKILL.md for.*|\1|p')")
    printf '%s\n' "$skill" > "$dir/skills/$session"
fi
n=$(($(find "$dir/launches" -maxdepth 1 -name "$skill.*" | wc -l) + 1))
launch=$(mktemp -d "$dir/launches/$skill.$n.XXXX")
printf '%s\n' "$@" > "$launch/argv"
env > "$launch/env"
pwd > "$launch/cwd"
printf '%s\n' "$prompt" > "$launch/stdin"
pwd >> "$dir/launches.log"
script="$dir/sessions/$skill.$n.jsonl"
[ -e "$script" ] || script="$dir/sessions/$skill.jsonl"
while IFS= read -r line <&3; do
    case $line in
        "wait "*) while [ ! -e "$dir/${line#wait }" ]; do sleep 0.05; done ;;
        read) IFS= read -r message && printf '%s\n' "$message" >> "$launch/stdin" ;;
        *) printf '%s\n' "${line//\$SESSION/$session}" ;;
    esac
done 3< "$script"
cat > /dev/null # like claude, it stays until Ants closes stdin
