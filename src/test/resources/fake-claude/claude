#!/bin/bash
# A fake `claude` for tests, run from a copy in its own folder. `--help` prints ./help, if there is one. `auth status`
# prints $CLAUDE_CONFIG_DIR/auth-status.json, or, like a logged-out claude, a loggedIn false and exit 1. Otherwise it
# records its argv, environment, working directory and stdin's first line under ./launches/<skill>.<n> for the nth
# launch of that Skill, appends its working directory to ./launches.log, and plays ./sessions/<skill>.<n>.jsonl, or
# ./sessions/<skill>.jsonl when there is none. The Skill is picked by the hand-off line, or for `--resume` by the
# session's first launch; a launch with neither, a So far rewrite, plays the Skill `so-far`. Like claude with
# --replay-user-messages, it echoes every stdin message with "isReplay":true.
# A session line `wait <file>` waits until ./<file> exists, `read` reads the next stdin line into the launch's stdin
# record (a control request, such as Stop's interrupt, is not echoed), `stderr <text>` prints to stderr and `exit <code>`
# exits, and `write <file> <text>` writes <text> (`\n` for a newline) to <file> in its working directory, as an Agent's
# Write tool would; every other line is printed. $SESSION stands for the --session-id or --resume. A launch that is killed leaves
# ./launches/<skill>.<n>/killed.
dir=$(cd "$(dirname "$0")" && pwd)
if [ "$1" = --help ]; then cat "$dir/help" 2>/dev/null; exit 0; fi
if [ "$1 $2" = "auth status" ]; then cat "$CLAUDE_CONFIG_DIR/auth-status.json" 2>/dev/null || { echo '{"loggedIn":false,"authMethod":"none"}'; exit 1; }; exit 0; fi
session= previous=
for arg; do case $previous in --session-id|--resume) session=$arg ;; esac; previous=$arg; done
IFS= read -r prompt
skill=$(basename "$(printf '%s' "$prompt" | sed -n 's|.*Follow the Skill in \(.*\)/SKILL.md for.*|\1|p')")
mkdir -p "$dir/launches" "$dir/skills"
if [ -n "$skill" ]; then printf '%s' "$skill" > "$dir/skills/$session"
elif [ -n "$session" ]; then skill=$(cat "$dir/skills/$session")
else skill=so-far; fi
n=1
while ! mkdir "$dir/launches/$skill.$n" 2>/dev/null; do n=$((n + 1)); done
launch=$dir/launches/$skill.$n
printf '%s\n' "$@" > "$launch/argv"
env > "$launch/env"
pwd > "$launch/cwd"
printf '%s\n' "$prompt" > "$launch/stdin"
pwd >> "$dir/launches.log"
trap 'touch "$launch/killed"; exit 143' TERM
replay() { printf '%s\n' "${1%\}},\"isReplay\":true}"; }
replay "$prompt"
script=$dir/sessions/$skill.$n.jsonl
[ -e "$script" ] || script=$dir/sessions/$skill.jsonl
while IFS= read -r line <&3; do
    line=${line//\$SESSION/$session}
    case $line in
        "wait "*) while [ ! -e "$dir/${line#wait }" ]; do sleep 0.05; done ;;
        read) IFS= read -r message && printf '%s\n' "$message" >> "$launch/stdin" &&
            case $message in *'"type":"control_request"'*) ;; *) replay "$message" ;; esac ;;
        "stderr "*) printf '%s\n' "${line#stderr }" >&2 ;;
        "exit "*) exit "${line#exit }" ;;
        "write "*) file=${line#write }; file=${file%% *}; mkdir -p "$(dirname "$file")"; printf '%b' "${line#write "$file" }" > "$file" ;;
        *) printf '%s\n' "$line" ;;
    esac
done 3< "$script"
cat > /dev/null # like claude, it stays until Ants closes stdin
